# ============================================================
# CMS Database Configuration Template
# ============================================================
# Copy this file to db.properties and fill in your credentials.
# db.properties is gitignored so your password stays local.
# ============================================================

db.url=jdbc:mysql://localhost:3306/cms_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
db.username=root
db.password=YOUR_MYSQL_PASSWORD_HERE
db.driver=com.mysql.cj.jdbc.Driver

app.name=CMS v5.0
app.env=development
