<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.LoginController"
            stylesheets="@../css/login.css"
            styleClass="main-container">

    <GridPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        
        <columnConstraints>
            <ColumnConstraints percentWidth="42.0" />
            <ColumnConstraints percentWidth="58.0" />
        </columnConstraints>
        
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS" />
        </rowConstraints>

        <!-- LEFT PANEL (42%): Branding -->
        <VBox GridPane.columnIndex="0" styleClass="left-panel">
            <!-- Spacer to push content to ~40% from top -->
            <Region VBox.vgrow="ALWAYS" maxHeight="400" prefHeight="240"/>
            
            <VBox alignment="CENTER" spacing="0">
                <StackPane>
                    <!-- Main Outer Shield -->
                    <SVGPath content="M24 4L6 10v12c0 11.1 7.68 21.48 18 24 10.32-2.52 18-12.9 18-24V10L24 4z"
                             fill="transparent" stroke="#00d4ff" strokeWidth="2.0" scaleX="3.0" scaleY="3.0"/>
                    <!-- Inner Outlined Shield -->
                    <SVGPath content="M24 8L10 12.5v9.5c0 8.32 5.76 16.11 14 18 8.24-1.89 14-9.68 14-18v-9.5L24 8z"
                             fill="transparent" stroke="#00d4ff" strokeWidth="1.0" scaleX="2.8" scaleY="2.8" opacity="0.6"/>
                </StackPane>
                
                <Region prefHeight="80"/>
                
                <Label text="CMS" styleClass="logo-text"/>
                <Label text="C R I M E   M A N A G E M E N T   S Y S T E M" styleClass="logo-subtitle"/>
                <Label text="v 5 . 0" styleClass="version-label">
                    <VBox.margin>
                        <Insets top="8"/>
                    </VBox.margin>
                </Label>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" />
        </VBox>

        <!-- RIGHT PANEL (58%): Form -->
        <VBox GridPane.columnIndex="1" styleClass="right-panel">
            <!-- Spacer to push content to ~45% from top -->
            <Region VBox.vgrow="ALWAYS" maxHeight="450" prefHeight="280"/>
            
            <VBox spacing="35" maxWidth="400" alignment="CENTER_LEFT" VBox.vgrow="NEVER">
                <VBox spacing="8">
                    <Label text="Welcome Back" styleClass="heading"/>
                    <Label text="Official credentials required to access the system." styleClass="subtext"/>
                </VBox>

                <VBox spacing="20">
                    <VBox spacing="8">
                        <Label text="B A D G E   N U M B E R   /   U S E R N A M E" styleClass="field-label"/>
                        <TextField fx:id="usernameField" promptText="Enter system ID"
                                   styleClass="input-field"/>
                    </VBox>
                    
                    <VBox spacing="8">
                        <Label text="S Y S T E M   P A S S W O R D" styleClass="field-label"/>
                        <PasswordField fx:id="passwordField" promptText="••••••••"
                                       styleClass="input-field"/>
                    </VBox>
                    
                    <VBox spacing="15" alignment="CENTER">
                        <Button fx:id="loginButton" text="AUTHENTICATE SYSTEM ACCESS"
                                onAction="#handleLogin" maxWidth="Infinity"
                                styleClass="auth-btn"/>
                        <Label fx:id="errorLabel" styleClass="error-label"
                               wrapText="true" alignment="CENTER" minHeight="20"/>
                    </VBox>
                </VBox>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- Footer Area -->
            <VBox alignment="CENTER" spacing="15">
                <Separator styleClass="footer-rule" maxWidth="400"/>
                <HBox alignment="CENTER" spacing="5">
                    <Label text="Technical difficulties?" styleClass="subtext"/>
                    <Hyperlink text="Contact System Administrator" styleClass="footer-link"
                               onAction="#handleContactAdmin"/>
                </HBox>
                <padding>
                    <Insets bottom="40"/>
                </padding>
            </VBox>
        </VBox>
    </GridPane>
</AnchorPane>
