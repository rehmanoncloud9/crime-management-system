<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.LoginController"
            stylesheets="@../css/login.css"
            styleClass="main-container">

    <GridPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <columnConstraints>
            <ColumnConstraints percentWidth="52.0" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="48.0" hgrow="ALWAYS"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS"/>
        </rowConstraints>

        <!-- LEFT: Branding panel -->
        <VBox GridPane.columnIndex="0" styleClass="left-panel" spacing="0">
            <VBox alignment="CENTER" spacing="16">

                <!-- Shield SVG icon -->
                <StackPane styleClass="logo-shield" maxWidth="120" maxHeight="120">
                    <SVGPath content="M24 4L6 10v12c0 11.1 7.68 21.48 18 24 10.32-2.52 18-12.9 18-24V10L24 4z"
                             fill="transparent" stroke="#00E5FF" strokeWidth="2"
                             scaleX="3.5" scaleY="3.5"/>
                    <SVGPath content="M24 10l-10 4v8c0 6 4 11 10 13 6-2 10-7 10-13v-8l-10-4z"
                             fill="#00E5FF" opacity="0.12" scaleX="3.5" scaleY="3.5"/>
                </StackPane>

                <Region prefHeight="40"/>

                <Label text="CMS" styleClass="logo-text"/>
                <Label text="CRIME MANAGEMENT SYSTEM" styleClass="logo-subtitle"/>

                <Region prefHeight="32"/>

                <!-- Feature bullets -->
                <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="280">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="✦" style="-fx-text-fill: #00E5FF; -fx-font-size: 10px;"/>
                        <Label text="Real-time incident tracking" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 12px;"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="✦" style="-fx-text-fill: #00E5FF; -fx-font-size: 10px;"/>
                        <Label text="AI-powered case analytics" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 12px;"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="✦" style="-fx-text-fill: #00E5FF; -fx-font-size: 10px;"/>
                        <Label text="Encrypted evidence management" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 12px;"/>
                    </HBox>
                </VBox>

                <Region prefHeight="20"/>
                <Label text="v6.0 · CLASSIFIED" styleClass="version-label"/>
            </VBox>
        </VBox>

        <!-- RIGHT: Login form -->
        <VBox GridPane.columnIndex="1" styleClass="right-panel">
            <VBox spacing="36" maxWidth="400" alignment="CENTER_LEFT">

                <!-- Heading -->
                <VBox spacing="8">
                    <Label text="Welcome Back" styleClass="heading"/>
                    <Label text="Authorized personnel only. Enter your credentials to proceed."
                           styleClass="subtext" wrapText="true"/>
                </VBox>

                <!-- Form fields -->
                <VBox spacing="22">
                    <VBox spacing="8">
                        <Label text="BADGE NUMBER / USERNAME" styleClass="field-label"/>
                        <HBox styleClass="input-container">
                            <TextField fx:id="usernameField" promptText="Enter your system ID"
                                       HBox.hgrow="ALWAYS" styleClass="input-field"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="SYSTEM PASSWORD" styleClass="field-label"/>
                        <HBox styleClass="input-container">
                            <StackPane HBox.hgrow="ALWAYS">
                                <PasswordField fx:id="passwordField" promptText="••••••••••"
                                               styleClass="input-field"/>
                                <TextField fx:id="passwordTextField" visible="false" managed="false"
                                           promptText="••••••••••" styleClass="input-field"/>
                            </StackPane>
                            <StackPane onMouseClicked="#togglePasswordVisibility" style="-fx-cursor: hand;">
                                <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                         styleClass="eye-icon" scaleX="0.8" scaleY="0.8"/>
                                <padding>
                                    <Insets top="0" right="4" bottom="0" left="12"/>
                                </padding>
                            </StackPane>
                        </HBox>
                    </VBox>

                    <VBox spacing="16" alignment="CENTER">
                        <Button fx:id="loginButton" text="AUTHENTICATE"
                                onAction="#handleLogin" maxWidth="Infinity"
                                styleClass="auth-btn"/>
                        <Label fx:id="errorLabel" styleClass="error-label"
                               wrapText="true" alignment="CENTER" minHeight="20"/>
                    </VBox>
                </VBox>

                <Region prefHeight="10"/>

                <!-- Footer -->
                <HBox alignment="CENTER" spacing="6">
                    <Label text="Technical difficulties?" styleClass="footer-text"/>
                    <Hyperlink text="Contact System Admin" styleClass="footer-link"
                               onAction="#handleContactAdmin"/>
                </HBox>

            </VBox>
        </VBox>

    </GridPane>
</AnchorPane>
