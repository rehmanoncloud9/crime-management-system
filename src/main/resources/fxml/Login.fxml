<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.LoginController"
            stylesheets="@../css/login.css">

    <HBox AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0"
          prefWidth="1000" prefHeight="620">

        <!-- LEFT: BRANDING PANEL -->
        <VBox prefWidth="430" alignment="CENTER" styleClass="left-panel" HBox.hgrow="ALWAYS" spacing="16">
            <Label text="🛡" styleClass="logo-icon"/>
            <Label text="CMS" styleClass="logo"/>
            <Label text="CRIME MANAGEMENT SYSTEM" styleClass="subtitle"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="v5.0  •  SECURE ACCESS GATEWAY  •  ELITE DIVISION"
                   styleClass="subtitle" style="-fx-opacity: 0.45; -fx-font-size: 10px;"/>
        </VBox>

        <!-- RIGHT: LOGIN FORM -->
        <VBox prefWidth="570" alignment="CENTER" styleClass="right-panel" HBox.hgrow="ALWAYS">
            <VBox spacing="32" maxWidth="390" alignment="CENTER_LEFT">

                <VBox spacing="6">
                    <Label text="Welcome Back" styleClass="title"/>
                    <Label text="Official credentials required to access the system" styleClass="desc"/>
                </VBox>

                <VBox spacing="22">
                    <VBox spacing="8" styleClass="input-group">
                        <Label text="BADGE NUMBER / USERNAME" styleClass="input-label"/>
                        <TextField fx:id="usernameField" promptText="Enter your badge number"
                                   styleClass="input"/>
                    </VBox>
                    <VBox spacing="8" styleClass="input-group">
                        <Label text="SYSTEM PASSWORD" styleClass="input-label"/>
                        <PasswordField fx:id="passwordField" promptText="Enter your password"
                                       styleClass="input"/>
                    </VBox>
                    <Button fx:id="loginButton" text="◉  AUTHENTICATE  ◉"
                            onAction="#handleLogin" maxWidth="Infinity"
                            styleClass="login-btn"/>
                    <Label fx:id="errorLabel" styleClass="error-text"
                           wrapText="true" alignment="CENTER"/>
                </VBox>

                <Region prefHeight="30"/>

                <VBox spacing="10" alignment="CENTER">
                    <Separator/>
                    <HBox alignment="CENTER" spacing="6">
                        <Label text="Need assistance?" styleClass="desc"/>
                        <Hyperlink text="Contact IT Helpdesk"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </HBox>
</AnchorPane>
