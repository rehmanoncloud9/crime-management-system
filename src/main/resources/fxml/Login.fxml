<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.LoginController"
            stylesheets="@../css/login.css"
            styleClass="main-container">

    <!-- Background Orbs for Aurora Effect (Moving) -->
    <Region fx:id="orb1" layoutX="-100" layoutY="-100" prefWidth="600" prefHeight="600" opacity="0.18" 
            style="-fx-background-color: radial-gradient(center 50% 50%, radius 50%, #00E5C8 0%, transparent 80%); -fx-background-radius: 1000;"/>
    <Region fx:id="orb2" layoutX="800" layoutY="200" prefWidth="500" prefHeight="500" opacity="0.12" 
            style="-fx-background-color: radial-gradient(center 50% 50%, radius 50%, #B388FF 0%, transparent 80%); -fx-background-radius: 1000;"/>
    <Region fx:id="orb3" layoutX="400" layoutY="500" prefWidth="550" prefHeight="550" opacity="0.1" 
            style="-fx-background-color: radial-gradient(center 50% 50%, radius 50%, #40C4FF 0%, transparent 80%); -fx-background-radius: 1000;"/>

    <GridPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" style="-fx-background-color: transparent;">

        <columnConstraints>
            <ColumnConstraints percentWidth="52.0" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="48.0" hgrow="ALWAYS"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS"/>
        </rowConstraints>

        <!-- LEFT: Branding panel -->
        <VBox GridPane.columnIndex="0" styleClass="left-panel" spacing="0" style="-fx-background-color: transparent;">
            <VBox alignment="CENTER" spacing="16">

                <!-- Shield SVG icon - Multi-layer Liquid Glass -->
                <StackPane styleClass="logo-shield" maxWidth="150" maxHeight="150">
                    <!-- Ambient Glow -->
                    <SVGPath content="M24 4L6 10v12c0 11.1 7.68 21.48 18 24 10.32-2.52 18-12.9 18-24V10L24 4z"
                             fill="rgba(0,191,165,0.2)" scaleX="4.4" scaleY="4.4" />
                    <!-- Frosted Glass Base -->
                    <SVGPath content="M24 4L6 10v12c0 11.1 7.68 21.48 18 24 10.32-2.52 18-12.9 18-24V10L24 4z"
                             fill="linear-gradient(to bottom right, rgba(255,255,255,0.9), rgba(255,255,255,0.3))" 
                             scaleX="4.0" scaleY="4.0"/>
                    <!-- Liquid Core Gradient -->
                    <SVGPath content="M24 10l-10 4v8c0 6 4 11 10 13 6-2 10-7 10-13v-8l-10-4z"
                             fill="linear-gradient(to bottom right, #00BFA5, #40C4FF)" opacity="0.85" scaleX="4.0" scaleY="4.0"/>
                    <!-- Glass Edge Highlight -->
                    <SVGPath content="M24 4L6 10v12c0 11.1 7.68 21.48 18 24 10.32-2.52 18-12.9 18-24V10L24 4z"
                             fill="transparent" stroke="white" strokeWidth="1.2" opacity="0.9"
                             scaleX="4.0" scaleY="4.0"/>
                </StackPane>

                <Region prefHeight="40"/>

                <Label text="CMS" styleClass="logo-text"/>
                <Label text="CRIME MANAGEMENT SYSTEM" styleClass="logo-subtitle"/>

                <Region prefHeight="32"/>

                <!-- Feature bullets -->
                <VBox spacing="12" alignment="CENTER_LEFT" maxWidth="280">
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Label text="●" style="-fx-text-fill: #00BFA5; -fx-font-size: 8px;"/>
                        <Label text="Real-time incident tracking" style="-fx-text-fill: #2E4A48; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                    </HBox>
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Label text="●" style="-fx-text-fill: #00BFA5; -fx-font-size: 8px;"/>
                        <Label text="AI-powered case analytics" style="-fx-text-fill: #2E4A48; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                    </HBox>
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Label text="●" style="-fx-text-fill: #00BFA5; -fx-font-size: 8px;"/>
                        <Label text="Encrypted evidence management" style="-fx-text-fill: #2E4A48; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                    </HBox>
                </VBox>

                <Region prefHeight="20"/>
                <Label text="v7.0 · AURORA NEXUS" styleClass="version-label"/>
            </VBox>
        </VBox>

        <!-- RIGHT: Login form -->
        <VBox GridPane.columnIndex="1" styleClass="right-panel" style="-fx-background-color: transparent;">
            <VBox spacing="36" maxWidth="420" alignment="CENTER_LEFT" styleClass="glass-card">

                <!-- Heading -->
                <VBox spacing="8">
                    <Label text="Welcome Back" styleClass="heading"/>
                    <Label text="Authorized personnel only. Enter your credentials to proceed."
                           styleClass="subtext" wrapText="true"/>
                </VBox>

                <!-- Form fields -->
                <VBox spacing="22">
                    <VBox spacing="8">
                        <Label text="BADGE NUMBER / USERNAME" styleClass="field-label"/>
                        <HBox styleClass="input-container">
                            <TextField fx:id="usernameField" promptText="Enter your system ID"
                                       HBox.hgrow="ALWAYS" styleClass="input-field"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="SYSTEM PASSWORD" styleClass="field-label"/>
                        <HBox styleClass="input-container">
                            <StackPane HBox.hgrow="ALWAYS">
                                <PasswordField fx:id="passwordField" promptText="••••••••••"
                                               styleClass="input-field"/>
                                <TextField fx:id="passwordTextField" visible="false" managed="false"
                                           promptText="••••••••••" styleClass="input-field"/>
                            </StackPane>
                            <StackPane onMouseClicked="#togglePasswordVisibility" style="-fx-cursor: hand;">
                                <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                         styleClass="eye-icon" scaleX="0.8" scaleY="0.8"/>
                                <padding>
                                    <Insets top="0" right="4" bottom="0" left="12"/>
                                </padding>
                            </StackPane>
                        </HBox>
                    </VBox>

                    <VBox spacing="16" alignment="CENTER">
                        <Button fx:id="loginButton" text="AUTHENTICATE"
                                onAction="#handleLogin" maxWidth="Infinity"
                                styleClass="auth-btn"/>
                        <Label fx:id="errorLabel" styleClass="error-label"
                               wrapText="true" alignment="CENTER" minHeight="20"/>
                    </VBox>
                </VBox>

                <Region prefHeight="10"/>

                <!-- Footer -->
                <HBox alignment="CENTER" spacing="6">
                    <Label text="Need assistance?" styleClass="footer-text"/>
                    <Hyperlink text="WhatsApp System Admin" styleClass="footer-link"
                               onAction="#handleContactAdmin" style="-fx-text-fill: #10B981;"/>
                </HBox>

            </VBox>
        </VBox>

    </GridPane>
</AnchorPane>
