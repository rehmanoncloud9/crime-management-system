<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.MainController"
            style="-fx-background-color: -cms-mist;">

    <!-- TOP: Frosted glass header -->
    <top>
        <fx:include source="SessionHeader.fxml"/>
    </top>

    <!-- BODY -->
    <center>
        <StackPane>
            <!-- Background Orbs for Aurora Effect -->
            <Region layoutX="-200" layoutY="-200" prefWidth="600" prefHeight="600" opacity="0.1" 
                    style="-fx-background-color: radial-gradient(center 50% 50%, radius 50%, #00E5C8 0%, transparent 80%); -fx-background-radius: 1000;"/>
            <Region layoutX="900" layoutY="400" prefWidth="500" prefHeight="500" opacity="0.08" 
                    style="-fx-background-color: radial-gradient(center 50% 50%, radius 50%, #B388FF 0%, transparent 80%); -fx-background-radius: 1000;"/>
            
            <!-- MAIN CONTENT AREA (Takes full background) -->
            <ScrollPane fitToWidth="true" fitToHeight="true" 
                        style="-fx-background-color: transparent; -fx-border-color: transparent;"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        styleClass="main-content-scroll">
                <StackPane fx:id="contentArea"
                           style="-fx-background-color: transparent; -fx-padding: 0;"/>
            </ScrollPane>

            <!-- FLOATING SIDEBAR (Bottom Right) -->
            <ScrollPane fx:id="sidebarScroll"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="NEVER"
                        StackPane.alignment="BOTTOM_RIGHT"
                        maxWidth="200"
                        maxHeight="400"
                        style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 24 24 0;"
                        styleClass="sidebar-scroll-floating">
                <VBox fx:id="sideMenu"
                      prefWidth="180"
                      styleClass="sidebar-floating">
                    <VBox styleClass="sidebar-brand-floating">
                        <Label text="CMS" styleClass="brand-title-sm"/>
                    </VBox>
                    <!-- Menu buttons injected by MainController.buildSidebar() -->
                </VBox>
            </ScrollPane>

        </StackPane>
    </center>

</BorderPane>
