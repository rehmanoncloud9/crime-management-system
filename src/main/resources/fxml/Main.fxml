<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.MainController"
            style="-fx-background-color: #07090F;">

    <!-- TOP: Session Header -->
    <top>
        <fx:include source="SessionHeader.fxml"/>
    </top>

    <!-- BODY -->
    <center>
        <HBox style="-fx-background-color: #07090F;" alignment="TOP_LEFT">

            <!-- SIDEBAR: with ScrollPane for independent scrolling -->
            <ScrollPane fx:id="sidebarScroll" 
                        fitToWidth="true" 
                        hbarPolicy="NEVER" 
                        vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: #060A14; -fx-border-color: transparent;"
                        styleClass="sidebar-scroll">
                <VBox fx:id="sideMenu"
                      prefWidth="240" minWidth="240"
                      style="-fx-background-color: #060A14;"
                      styleClass="sidebar">
                    <VBox styleClass="sidebar-brand">
                        <Label text="🛡 CMS" styleClass="brand-title"/>
                        <Label text="Crime Management System" styleClass="brand-subtitle"/>
                    </VBox>
                    <Separator/>
                    <!-- Menu buttons injected by MainController.buildSidebar() -->
                </VBox>
            </ScrollPane>

            <!-- MAIN CONTENT AREA: Independent scrolling -->
            <ScrollPane fitToWidth="true" fitToHeight="true" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        styleClass="main-content-scroll">
                <StackPane fx:id="contentArea"
                           style="-fx-background-color: #07090F; -fx-padding: 0;"/>
            </ScrollPane>

        </HBox>
    </center>

</BorderPane>
