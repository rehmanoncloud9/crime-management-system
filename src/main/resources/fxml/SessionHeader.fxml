<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<HBox alignment="CENTER_LEFT" spacing="12" styleClass="app-header"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.HeaderController">

    <!-- LEFT: NAVIGATION PILL -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="header-nav-pill">
        <Button fx:id="menuToggleBtn" text="&#9776;" onAction="#handleMenuToggle"
                styleClass="btn-icon-premium"/>
        <Separator orientation="VERTICAL" prefHeight="20" styleClass="header-sep"/>
        <HBox alignment="CENTER_LEFT" spacing="8">
             <Button fx:id="backBtn" text="&#8617;" onAction="#handleBack"
                     styleClass="btn-icon-sm" visible="false" managed="false"/>
             <Label text="DASHBOARD" styleClass="header-title-premium"/>
             <FlowPane fx:id="breadcrumbPane" hgap="4" alignment="CENTER_LEFT"
                       styleClass="breadcrumb-container" visible="false" managed="false"/>
        </HBox>
    </HBox>
 
    <Region HBox.hgrow="ALWAYS"/>
 
    <!-- CENTER: USER HUB -->
    <HBox alignment="CENTER" spacing="14" styleClass="header-user-hub">
        <StackPane styleClass="avatar-wrapper">
            <Circle fx:id="profileCircle" radius="18" fill="white" stroke="#00BFA5" strokeWidth="2"/>
            <Label fx:id="initialsLabel" text="?" styleClass="avatar-initials"/>
        </StackPane>
        <VBox alignment="CENTER_LEFT" spacing="0">
            <Label fx:id="userNameLabel" text="Rehman OnCloud9" styleClass="hub-username"/>
            <Label fx:id="officerRankLabel" text="ADMINISTRATOR" styleClass="hub-rank"/>
        </VBox>
        <StackPane styleClass="role-indicator-glow">
             <Label fx:id="roleBadge" text="ADMIN" styleClass="role-pill-neon"/>
        </StackPane>
    </HBox>
 
    <Region HBox.hgrow="ALWAYS"/>
 
    <!-- RIGHT: ACTION & CLOCK HUB -->
    <HBox alignment="CENTER_RIGHT" spacing="16">
        <!-- Clock Widget -->
        <VBox alignment="CENTER_RIGHT" spacing="0" styleClass="header-clock-widget">
            <Label fx:id="dateLabel" text="Wednesday, 06 May 2026" styleClass="clock-date"/>
            <Label fx:id="timeLabel" text="19:50:00" styleClass="clock-time"/>
        </VBox>
 
        <HBox alignment="CENTER" spacing="8" styleClass="header-action-hub">
            <StackPane>
                <Button fx:id="notificationBtn" text="&#128276;" onAction="#handleNotificationClick"
                        styleClass="btn-notif-premium"/>
                <StackPane alignment="TOP_RIGHT" pickOnBounds="false" translateY="-2" translateX="2">
                    <Circle radius="8" fill="#FF5252" stroke="white" strokeWidth="1.2"/>
                    <Label fx:id="notifCountLabel" text="0" styleClass="notif-text-premium"/>
                </StackPane>
            </StackPane>
            
            <Separator orientation="VERTICAL" prefHeight="20" styleClass="header-sep-lite"/>
            
            <Button fx:id="logoutBtn" text="LOGOUT" onAction="#handleLogout" styleClass="btn-logout-premium"/>
        </HBox>
    </HBox>

</HBox>
