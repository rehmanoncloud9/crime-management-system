<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<HBox alignment="CENTER_LEFT" spacing="12" styleClass="app-header"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.HeaderController">

    <!-- HAMBURGER TOGGLE -->
    <Button fx:id="menuToggleBtn" text="&#9776;" onAction="#handleMenuToggle"
            styleClass="btn-icon"
            style="-fx-font-size: 17px; -fx-min-width: 38; -fx-min-height: 38; -fx-cursor: hand;"/>

    <!-- BREADCRUMB / MODULE TITLE -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="header-nav">
        <Button fx:id="backBtn" text="&#8617;" onAction="#handleBack"
                styleClass="btn-icon, btn-back" visible="false" managed="false"
                style="-fx-font-size: 15px;"/>
        <Label text="DASHBOARD" styleClass="header-module-title"/>
        <FlowPane fx:id="breadcrumbPane" hgap="4" alignment="CENTER_LEFT"
                  styleClass="breadcrumb-container" visible="false" managed="false"/>
    </HBox>

    <Region HBox.hgrow="ALWAYS"/>

    <!-- USER PROFILE -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <StackPane>
            <Circle fx:id="profileCircle" radius="18"
                    fill="rgba(0,229,255,0.1)"
                    stroke="rgba(0,229,255,0.45)" strokeWidth="1.5"/>
            <Label fx:id="initialsLabel" text="?"
                   style="-fx-font-weight: 800; -fx-font-size: 13px; -fx-text-fill: #00E5FF;"/>
        </StackPane>
        <VBox alignment="CENTER_LEFT" spacing="1">
            <Label fx:id="userNameLabel" text="Officer Name" styleClass="header-username"/>
            <Label fx:id="officerRankLabel" text="Rank · Badge" styleClass="header-rank"/>
            <Label fx:id="precinctLabel" text="" styleClass="text-muted-xs" visible="true" managed="true"/>
        </VBox>
        <Label fx:id="roleBadge" text="OFFICER" styleClass="role-badge, role-badge-default"/>
    </HBox>

    <Region HBox.hgrow="ALWAYS"/>

    <!-- CLOCK -->
    <VBox alignment="CENTER_RIGHT" spacing="1">
        <Label fx:id="dateLabel" text="Saturday, 02 May 2026" styleClass="header-date"/>
        <Label fx:id="timeLabel" text="—" styleClass="header-clock"/>
    </VBox>

    <!-- ACTIONS -->
    <HBox alignment="CENTER" spacing="10">
        <!-- Notification bell -->
        <StackPane>
            <Button fx:id="notificationBtn" text="&#128276;" onAction="#handleNotificationClick"
                    styleClass="btn-icon" style="-fx-font-size: 16px;"/>
            <StackPane alignment="TOP_RIGHT" pickOnBounds="false">
                <StackPane styleClass="notif-badge" translateY="-4" translateX="4">
                    <Label fx:id="notifCountLabel" text="0"
                           style="-fx-font-size: 8px; -fx-text-fill: white; -fx-font-weight: 800;"/>
                </StackPane>
            </StackPane>
        </StackPane>

        <Button fx:id="logoutBtn" text="LOGOUT" onAction="#handleLogout"
                styleClass="btn-logout"/>
    </HBox>

</HBox>
