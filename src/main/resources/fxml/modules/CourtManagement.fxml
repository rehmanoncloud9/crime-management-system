<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true"  styleClass="scroll-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.CourtManagementController">
    <VBox spacing="16">
        <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>

        <Label text="Court Case &amp; Hearing Management" styleClass="heading-xl"/>

        <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
            <Tab text="⚖️ Ongoing Court Cases">
                <VBox spacing="12" style="-fx-padding: 12;">
                    <HBox spacing="12">
                        <Button text="+ Add Court Case" onAction="#handleAddCase" styleClass="btn, btn-primary"/>
                        <Button text="Refresh" onAction="#loadData" styleClass="btn, btn-outline"/>
                    </HBox>
                    <TableView fx:id="courtCasesTable" VBox.vgrow="ALWAYS" prefHeight="350">
                        <columns>
                            <TableColumn fx:id="courtCaseNumCol" text="Court Case #" prefWidth="140"/>
                            <TableColumn fx:id="internalCaseNumCol" text="CMS Case #" prefWidth="130"/>
                            <TableColumn fx:id="prosecutorCol" text="Prosecutor" prefWidth="160"/>
                            <TableColumn fx:id="statusCol" text="Legal Status" prefWidth="110"/>
                            <TableColumn fx:id="filedDateCol" text="Filed At" prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="📅 Upcoming Hearings">
                <VBox spacing="12" style="-fx-padding: 12;">
                    <HBox spacing="12">
                        <Button text="+ Schedule Hearing" onAction="#handleScheduleHearing" styleClass="btn, btn-success"/>
                        <Button text="Refresh" onAction="#loadData" styleClass="btn, btn-outline"/>
                    </HBox>
                    <TableView fx:id="hearingsTable" VBox.vgrow="ALWAYS" prefHeight="350">
                        <columns>
                            <TableColumn fx:id="hearingDateCol" text="Date &amp; Time" prefWidth="160"/>
                            <TableColumn fx:id="hCourtCaseNumCol" text="Court Case #" prefWidth="160"/>
                            <TableColumn fx:id="outcomeCol" text="Previous Outcome" prefWidth="220"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>
</ScrollPane>
