<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.PersonRegistrationController" styleClass="content-area">
        <padding><Insets bottom="16" left="16" right="16" top="16"/></padding>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <Button text="← Back to Registry" onAction="#handleBack" styleClass="btn-premium-outline-sm"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="formTitle" text="Person Registration Portal" styleClass="heading-xl"/>
    </HBox>

    <VBox spacing="24" styleClass="content-area-glass">
        <!-- Section 1: Identity Hub -->
        <HBox spacing="24">
            <VBox spacing="16" alignment="TOP_CENTER" styleClass="form-section-card" style="-fx-min-width: 220;">
                <Label text="PHOTO IDENTITY" styleClass="form-label-premium"/>
                <StackPane styleClass="photo-container-premium">
                    <ImageView fx:id="photoView" fitWidth="180" fitHeight="180" preserveRatio="true"/>
                </StackPane>
                <Button text="📷 UPLOAD BIOMETRIC" onAction="#handleUploadPhoto" styleClass="btn-premium-teal-sm" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="form-section-card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👤" style="-fx-font-size: 18px;"/>
                    <Label text="Personal Identification" styleClass="heading-md"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <CheckBox fx:id="unknownPersonCheck" text="UNKNOWN SUBJECT" style="-fx-text-fill: -cms-rose; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                </HBox>
                <GridPane hgap="30" vgap="18">
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="First Name" styleClass="form-label-premium"/>
                        <TextField fx:id="firstNameField" promptText="Given Name" prefWidth="250" styleClass="text-field-premium"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Last Name" styleClass="form-label-premium"/>
                        <TextField fx:id="lastNameField" promptText="Surname" prefWidth="250" styleClass="text-field-premium"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Classification" styleClass="form-label-premium"/>
                        <ComboBox fx:id="personStatusCombo" promptText="Select Status" prefWidth="250" styleClass="combo-box-premium"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Gender" styleClass="form-label-premium"/>
                        <ComboBox fx:id="genderCombo" promptText="Select Gender" prefWidth="250" styleClass="combo-box-premium"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Date of Birth" styleClass="form-label-premium"/>
                        <DatePicker fx:id="dobPicker" prefWidth="250" styleClass="date-picker-premium"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="CNIC / National ID" styleClass="form-label-premium"/>
                        <TextField fx:id="nationalIdField" promptText="XXXXX-XXXXXXX-X" prefWidth="250" styleClass="text-field-premium"/>
                    </VBox>
                </GridPane>
            </VBox>
        </HBox>

        <!-- Section 2: Criminal & Physical -->
        <HBox spacing="24">
            <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="form-section-card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="⚖️" style="-fx-font-size: 18px;"/>
                    <Label text="Criminal &amp; Affiliation" styleClass="heading-md"/>
                </HBox>
                <GridPane hgap="25" vgap="15">
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                        <Label text="Aliases (Monikers)" styleClass="form-label-premium"/>
                        <TextField fx:id="aliasesField" promptText="Separated by commas..." styleClass="text-field-premium"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Gang Affiliation" styleClass="form-label-premium"/>
                        <TextField fx:id="gangField" promptText="Known groups..." styleClass="text-field-premium"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1" alignment="BOTTOM_LEFT">
                        <CheckBox fx:id="warrantCheck" text="ACTIVE WARRANT" style="-fx-text-fill: -cms-rose; -fx-font-weight: 800;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="form-section-card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📏" style="-fx-font-size: 18px;"/>
                    <Label text="Physical Profile" styleClass="heading-md"/>
                </HBox>
                <HBox spacing="15">
                    <VBox spacing="6">
                        <Label text="Height (cm)" styleClass="form-label-premium"/>
                        <TextField fx:id="heightField" prefWidth="100" styleClass="text-field-premium"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Weight (kg)" styleClass="form-label-premium"/>
                        <TextField fx:id="weightField" prefWidth="100" styleClass="text-field-premium"/>
                    </VBox>
                </HBox>
                <VBox spacing="6">
                    <Label text="Distinguishing Marks" styleClass="form-label-premium"/>
                    <TextArea fx:id="marksArea" prefHeight="60" wrapText="true" styleClass="text-area-premium"/>
                </VBox>
            </VBox>
        </HBox>

        <!-- Section 3: Geographic & Medical -->
        <HBox spacing="24">
            <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="form-section-card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📍" style="-fx-font-size: 18px;"/>
                    <Label text="Residency Data" styleClass="heading-md"/>
                </HBox>
                <GridPane hgap="20" vgap="15">
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="District" styleClass="form-label-premium"/>
                        <ComboBox fx:id="districtCombo" prefWidth="180" styleClass="combo-box-premium"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="City" styleClass="form-label-premium"/>
                        <ComboBox fx:id="cityCombo" prefWidth="180" styleClass="combo-box-premium"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Area / Sector" styleClass="form-label-premium"/>
                        <ComboBox fx:id="areaCombo" prefWidth="180" styleClass="combo-box-premium"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3">
                        <Label text="Street Address / Details" styleClass="form-label-premium"/>
                        <TextArea fx:id="addressArea" prefHeight="60" wrapText="true" styleClass="text-area-premium"/>
                    </VBox>
                </GridPane>
            </VBox>

            <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="form-section-card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="💼" style="-fx-font-size: 18px;"/>
                    <Label text="Professional Context" styleClass="heading-md"/>
                </HBox>
                <GridPane hgap="20" vgap="15">
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Occupation" styleClass="form-label-premium"/>
                        <TextField fx:id="occupationField" promptText="Job Title" styleClass="text-field-premium"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Employer / Company" styleClass="form-label-premium"/>
                        <TextField fx:id="employerField" promptText="Current Employer" styleClass="text-field-premium"/>
                    </VBox>
                </GridPane>
            </VBox>

            <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="form-section-card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🏥" style="-fx-font-size: 18px;"/>
                    <Label text="Medical Records" styleClass="heading-md"/>
                </HBox>
                <HBox spacing="15">
                    <VBox spacing="6">
                        <Label text="Blood Group" styleClass="form-label-premium"/>
                        <ComboBox fx:id="bloodGroupCombo" prefWidth="120" styleClass="combo-box-premium"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="DNA Profile Reference" styleClass="form-label-premium"/>
                        <TextField fx:id="dnaProfileField" styleClass="text-field-premium"/>
                    </VBox>
                </HBox>
                <VBox spacing="6">
                    <Label text="Known Conditions / Injuries" styleClass="form-label-premium"/>
                    <TextArea fx:id="diseasesArea" prefHeight="60" wrapText="true" styleClass="text-area-premium"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>

    <HBox spacing="16" alignment="CENTER_RIGHT">
        <Button fx:id="saveBtn" onAction="#handleSave" text="COMMIT PROFILE" styleClass="btn-premium-teal"/>
        <Button onAction="#handleClear" text="CLEAR DATA" styleClass="btn-premium-danger-outline"/>
    </HBox>
</VBox>
