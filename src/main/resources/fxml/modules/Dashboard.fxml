<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.DashboardController"
            fitToWidth="true" styleClass="dashboard-scroll"
            stylesheets="@../../css/dashboard.css">

    <VBox spacing="28" styleClass="container">

        <!-- PAGE HEADER -->
        <VBox spacing="4">
            <Label text="System Dashboard" styleClass="page-title"/>
            <Label fx:id="userGreeting" text="Loading..." styleClass="desc"/>
        </VBox>

        <!-- KPI STAT CARDS -->
        <HBox spacing="16">
            <!-- Total Criminals -->
            <VBox styleClass="card card-criminals" HBox.hgrow="ALWAYS" spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="●" style="-fx-text-fill: #FF80AB; -fx-font-size: 10px;"/>
                    <Label text="TOTAL CRIMINALS" styleClass="card-title"/>
                </HBox>
                <HBox alignment="BOTTOM_LEFT" spacing="10">
                    <Label fx:id="criminalCount" text="—" styleClass="card-value"/>
                </HBox>
                <Label text="Registered in system" styleClass="text-muted" style="-fx-padding: 2 0 0 0;"/>
            </VBox>

            <!-- Active Cases -->
            <VBox styleClass="card card-cases" HBox.hgrow="ALWAYS" spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="●" style="-fx-text-fill: #00BFA5; -fx-font-size: 10px;"/>
                    <Label text="ACTIVE CASES" styleClass="card-title"/>
                </HBox>
                <HBox alignment="BOTTOM_LEFT" spacing="10">
                    <Label fx:id="caseCount" text="—" styleClass="card-value"/>
                </HBox>
                <Label text="Currently under investigation" styleClass="text-muted" style="-fx-padding: 2 0 0 0;"/>
            </VBox>

            <!-- Officers -->
            <VBox styleClass="card card-officers" HBox.hgrow="ALWAYS" spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="●" style="-fx-text-fill: #40C4FF; -fx-font-size: 10px;"/>
                    <Label text="OFFICERS" styleClass="card-title"/>
                </HBox>
                <HBox alignment="BOTTOM_LEFT" spacing="10">
                    <Label fx:id="officerCount" text="—" styleClass="card-value"/>
                </HBox>
                <Label text="Active personnel" styleClass="text-muted" style="-fx-padding: 2 0 0 0;"/>
            </VBox>

            <!-- Closed Cases -->
            <VBox styleClass="card card-closed" HBox.hgrow="ALWAYS" spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="●" style="-fx-text-fill: #B388FF; -fx-font-size: 10px;"/>
                    <Label text="CLOSED CASES" styleClass="card-title"/>
                </HBox>
                <HBox alignment="BOTTOM_LEFT" spacing="10">
                    <Label fx:id="closedCases" text="—" styleClass="card-value"/>
                </HBox>
                <Label text="Resolved &amp; closed" styleClass="text-muted" style="-fx-padding: 2 0 0 0;"/>
            </VBox>

            <!-- Total Incidents -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6"
                  style="-fx-border-color: transparent transparent transparent #F59E0B; -fx-border-width: 0 0 0 4;">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="●" style="-fx-text-fill: #F59E0B; -fx-font-size: 10px;"/>
                    <Label text="INCIDENTS" styleClass="card-title"/>
                </HBox>
                <HBox alignment="BOTTOM_LEFT" spacing="10">
                    <Label fx:id="incidentCount" text="—" styleClass="card-value" style="-fx-text-fill: #F59E0B;"/>
                </HBox>
                <Label text="Total reported" styleClass="text-muted" style="-fx-padding: 2 0 0 0;"/>
            </VBox>
        </HBox>

        <!-- MAIN CONTENT GRID -->
        <HBox spacing="24">

            <!-- LEFT COLUMN -->
            <VBox spacing="24" HBox.hgrow="ALWAYS">

                <!-- RECENT ACTIVITY -->
                <VBox styleClass="card" spacing="16">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Recent Activity" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                        <Hyperlink text="View all →" onAction="#handleAudit" styleClass="footer-link"/>
                    </HBox>

                    <ScrollPane fitToWidth="true" maxHeight="280" minHeight="160"
                                styleClass="internal-scroll" vbarPolicy="AS_NEEDED">
                        <VBox fx:id="recentActivityList" spacing="8">
                            <Label text="Loading activity..." styleClass="text-muted"/>
                        </VBox>
                    </ScrollPane>
                </VBox>

                <!-- QUICK ACTIONS -->
                <VBox styleClass="card" spacing="18">
                    <Label text="Quick Actions" styleClass="section-title"/>
                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                        </columnConstraints>
                        <Button text="New Case" onAction="#handleAddCase"
                                styleClass="quick-action-btn" maxWidth="Infinity" GridPane.columnIndex="0"/>
                        <Button text="Add Person" onAction="#handleAddCriminal"
                                styleClass="quick-action-btn" maxWidth="Infinity" GridPane.columnIndex="1"/>
                        <Button text="Officers" onAction="#handleAddOfficer"
                                styleClass="quick-action-btn" maxWidth="Infinity" GridPane.columnIndex="2"/>
                        <Button text="Reports" onAction="#handleReports"
                                styleClass="quick-action-btn" maxWidth="Infinity"
                                GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Button text="Settings" onAction="#handleSettings"
                                styleClass="quick-action-btn" maxWidth="Infinity"
                                GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Button text="Audit Log" onAction="#handleAudit"
                                styleClass="quick-action-btn" maxWidth="Infinity"
                                GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    </GridPane>
                </VBox>

            </VBox>

            <!-- RIGHT COLUMN -->
            <VBox spacing="24" prefWidth="340" minWidth="300">

                <!-- CRITICAL ALERTS (DB-driven) -->
                <VBox styleClass="card" spacing="14">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Critical Alerts" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="alertCountLabel" text=""
                               style="-fx-font-size:10px; -fx-text-fill: -cms-t3;"/>
                    </HBox>
                    <VBox fx:id="alertsContainer" spacing="10">
                        <Label text="Checking system alerts..." styleClass="text-muted"/>
                    </VBox>
                </VBox>

                <!-- SYSTEM STATUS -->
                <VBox styleClass="card" spacing="14">
                    <Label text="System Status" styleClass="section-title"/>
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="status-row">
                            <Label text="●" styleClass="status-indicator-ok"/>
                            <Label text="Database: Connected" styleClass="status-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                             <Label text="LIVE" styleClass="status-badge-live"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="status-row">
                            <Label text="●" styleClass="status-indicator-ok"/>
                            <Label text="Secure Server: Active" styleClass="status-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                             <Label text="OK" styleClass="status-badge-ok"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="status-row status-sync">
                            <Label text="●" styleClass="status-indicator-sync"/>
                            <Label fx:id="lastSyncLabel" text="Last Sync: Active" styleClass="status-label"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- CASE BREAKDOWN -->
                <VBox styleClass="card" spacing="14">
                    <Label text="Case Breakdown" styleClass="section-title"/>
                    <VBox fx:id="caseBreakdownContainer" spacing="8">
                        <Label text="Loading..." styleClass="text-muted"/>
                    </VBox>
                </VBox>

            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
