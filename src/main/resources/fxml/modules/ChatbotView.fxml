<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.ChatbotController"
      styleClass="content-area">
 
    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="app-header">
        <Label text="🤖" style="-fx-font-size: 22px;"/>
        <VBox spacing="2">
            <Label text="CMS Intelligence Assistant" styleClass="heading-md"/>
            <Label fx:id="statusLabel" text="AI Online" styleClass="text-muted-sm"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="clearChatButton" text="🗑 Clear Chat" onAction="#handleClearChat" styleClass="btn-logout" style="-fx-padding: 6 12; -fx-font-size: 11px;"/>
    </HBox>
 
    <!-- Chat scroll area -->
    <ScrollPane fx:id="chatScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                styleClass="chat-scroll-area" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
        <VBox fx:id="chatContainer" spacing="16" styleClass="chat-container">
            <!-- Messages will be injected here -->
        </VBox>
    </ScrollPane>
 
    <!-- Input bar -->
    <HBox fx:id="inputBar" alignment="CENTER" spacing="12" styleClass="app-header" style="-fx-border-width: 1 0 0 0; -fx-padding: 16 24;">
        <TextField fx:id="inputField" promptText="Ask anything about the system..."
                   HBox.hgrow="ALWAYS" styleClass="chat-input"/>
        <Button fx:id="sendButton" text="➤ SEND" onAction="#handleSend" styleClass="btn, btn-primary"/>
    </HBox>
</VBox>
