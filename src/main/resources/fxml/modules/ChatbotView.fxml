<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.ChatbotController"
      styleClass="module" style="-fx-background-color: #07090F;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #0A0E1A; -fx-padding: 14 20;
                 -fx-border-color: rgba(0,212,255,0.12); -fx-border-width: 0 0 1 0;">
        <Label text="🤖" style="-fx-font-size: 22px; -fx-text-fill: #00D4FF;"/>
        <VBox spacing="2">
            <Label text="CMS Intelligence Assistant"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00D4FF;"/>
            <Label fx:id="statusLabel" text="Connecting..."
                   style="-fx-font-size: 10px; -fx-text-fill: #2A4A5A;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="clearChatButton" text="🗑 Clear" onAction="#handleClearChat"
                style="-fx-background-color: rgba(255,71,87,0.1);
                       -fx-border-color: rgba(255,71,87,0.25); -fx-border-width: 1;
                       -fx-border-radius: 6; -fx-background-radius: 6;
                       -fx-text-fill: #FF4757; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 6 12;"/>
    </HBox>

    <!-- Chat scroll area -->
    <ScrollPane fx:id="chatScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-border-color: transparent;"
                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
        <VBox fx:id="chatContainer" style="-fx-background-color: #07090F; -fx-padding: 16;" spacing="8"/>
    </ScrollPane>

    <!-- Input bar -->
    <HBox fx:id="inputBar" alignment="CENTER" spacing="10"
          style="-fx-background-color: #0A0E1A; -fx-padding: 14 16;
                 -fx-border-color: rgba(0,212,255,0.12); -fx-border-width: 1 0 0 0;">
        <TextField fx:id="inputField" promptText="Ask anything about cases, suspects, evidence..."
                   HBox.hgrow="ALWAYS"
                   style="-fx-background-color: #060A14; -fx-text-fill: #00D4FF;
                          -fx-prompt-text-fill: rgba(0,212,255,0.3);
                          -fx-border-color: rgba(0,212,255,0.2); -fx-border-width: 1;
                          -fx-border-radius: 22; -fx-background-radius: 22;
                          -fx-padding: 10 18; -fx-font-size: 13px;"/>
        <Button fx:id="sendButton" text="➤ Send" onAction="#handleSend"
                style="-fx-background-color: linear-gradient(to right, #00AACC, #00D4FF);
                       -fx-text-fill: #07090F; -fx-font-weight: bold; -fx-font-size: 13px;
                       -fx-background-radius: 22; -fx-padding: 10 22; -fx-cursor: hand;
                       -fx-border-color: transparent;"/>
    </HBox>
</VBox>
