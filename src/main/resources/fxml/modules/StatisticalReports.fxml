<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.StatisticalReportsController">
    <VBox spacing="16" styleClass="content-area">
        <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>

        <Label text="Crime Statistics &amp; Reports" styleClass="heading-xl"/>

        <!-- Toolbar -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card">
            <DatePicker fx:id="startDatePicker" promptText="Start Date"/>
            <DatePicker fx:id="endDatePicker" promptText="End Date"/>
            <ComboBox fx:id="reportTypeCombo" promptText="Report Type"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleGenerate" text="GENERATE" styleClass="btn, btn-primary"/>
        </HBox>

        <!-- Charts -->
        <HBox spacing="16" VBox.vgrow="ALWAYS">
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                <LineChart fx:id="crimeTrendChart" title="Crime Trend (Monthly)" prefHeight="300">
                    <xAxis><CategoryAxis label="Month"/></xAxis>
                    <yAxis><NumberAxis label="Incidents"/></yAxis>
                </LineChart>
            </VBox>
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                <BarChart fx:id="districtChart" title="Incidents by District" prefHeight="300">
                    <xAxis><CategoryAxis label="District"/></xAxis>
                    <yAxis><NumberAxis label="Incidents"/></yAxis>
                </BarChart>
            </VBox>
        </HBox>

        <!-- Export Actions -->
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button onAction="#handleExportPDF" text="Export PDF" styleClass="btn, btn-danger"/>
            <Button onAction="#handleExportExcel" text="Export Excel" styleClass="btn, btn-success"/>
        </HBox>
    </VBox>
</ScrollPane>
