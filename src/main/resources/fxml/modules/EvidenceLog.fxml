<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.EvidenceLogController">
    <VBox spacing="16" styleClass="content-area">
        <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>

        <Label text="Evidence Log" styleClass="heading-xl"/>

        <!-- Form -->
        <VBox spacing="14" styleClass="card">
            <Label text="Log New Evidence" styleClass="heading-md"/>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Associated Case *:" styleClass="form-label"/>
                    <ComboBox fx:id="caseCombo" maxWidth="Infinity" promptText="Select Case"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Linked Suspect (Optional):" styleClass="form-label"/>
                    <ComboBox fx:id="suspectCombo" maxWidth="Infinity" promptText="Select Suspect"/>
                </VBox>
            </HBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Evidence Type *:" styleClass="form-label"/>
                    <ComboBox fx:id="typeCombo" maxWidth="Infinity" promptText="Select Type"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Collection Location *:" styleClass="form-label"/>
                    <TextField fx:id="locationField" promptText="Where was it collected?"/>
                </VBox>
            </HBox>

            <VBox spacing="6">
                <Label text="Storage Location:" styleClass="form-label"/>
                <TextField fx:id="storageField" promptText="Evidence locker / storage reference"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Description *:" styleClass="form-label"/>
                <TextArea fx:id="descriptionArea" promptText="Detailed description of the evidence..."
                          prefRowCount="3" wrapText="true"/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Clear" onAction="#handleClear" styleClass="btn, btn-secondary"/>
                <Button text="Export Chain of Custody PDF" onAction="#handleExportPDF" styleClass="btn, btn-warning"/>
                <Button text="LOG EVIDENCE" onAction="#handleLog" styleClass="btn, btn-primary"/>
            </HBox>
        </VBox>

        <!-- Evidence Table -->
        <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
            <Label text="Evidence Records" styleClass="heading-md"/>
            <TableView fx:id="evidenceTable" prefHeight="300" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colEvNum"  text="Evidence #"    prefWidth="150"/>
                    <TableColumn fx:id="colCase"     text="Case #"        prefWidth="150"/>
                    <TableColumn fx:id="colType"     text="Type"          prefWidth="130"/>
                    <TableColumn fx:id="colStatus"   text="Status"        prefWidth="130"/>
                    <TableColumn fx:id="colLocation" text="Location"      prefWidth="200"/>
                </columns>
                <placeholder><Label text="No evidence records yet." style="-fx-text-fill: -cms-t3;"/></placeholder>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
