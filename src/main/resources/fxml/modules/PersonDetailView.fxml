<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.PersonDetailController" styleClass="module">
    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <!-- Top Profile Summary -->
    <HBox spacing="30" styleClass="card" alignment="CENTER_LEFT">
        <HBox spacing="20" alignment="CENTER_LEFT">
            <StackPane>
                <ImageView fx:id="photoView" fitWidth="110" fitHeight="110" preserveRatio="true"/>
                <Circle fx:id="statusCircle" radius="8" StackPane.alignment="BOTTOM_RIGHT">
                    <StackPane.margin><Insets bottom="5" right="5"/></StackPane.margin>
                </Circle>
            </StackPane>
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label fx:id="nameLabel" styleClass="heading-lg" text="Person Name"/>
                <Label fx:id="nationalIdLabel" styleClass="text-muted" text="CNIC: 00000-0000000-0"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                   <Label fx:id="classificationLabel" styleClass="badge, badge-active"/>
                   <Label fx:id="riskLabel" styleClass="badge, badge-pending"/>
                </HBox>
            </VBox>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Actions Toolbar -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Update Status" onAction="#handleUpdateStatus" styleClass="btn, btn-outline"/>
            <Button text="Link to Case" onAction="#handleLinkToCase" styleClass="btn, btn-primary"/>
            <Button text="Edit Profile" onAction="#handleEditProfile" styleClass="btn, btn-outline"/>
        </HBox>
    </HBox>

    <!-- Tabbed Content Area -->
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="cms-tabs">
        <Tab text="OVERVIEW">
            <HBox spacing="20" style="-fx-padding: 20 0 0 0;">
                <VBox spacing="20" prefWidth="400">
                    <VBox spacing="12" styleClass="card">
                        <Label text="Personal Details" styleClass="heading-sm"/>
                        <GridPane vgap="12" hgap="15">
                            <Label text="Gender:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="label-sm"/>
                            <Label fx:id="genderLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            
                            <Label text="DOB:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="label-sm"/>
                            <Label fx:id="dobLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            
                            <Label text="Nationality:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="label-sm"/>
                            <Label fx:id="nationalityLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="Warrant Status:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="label-sm"/>
                            <Label fx:id="warrantLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        </GridPane>
                    </VBox>

                    <VBox spacing="12" styleClass="card">
                        <Label text="Physical Characteristics" styleClass="heading-sm"/>
                        <GridPane vgap="12" hgap="15">
                            <Label text="Height:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="label-sm"/>
                            <Label fx:id="heightLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            
                            <Label text="Weight:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="label-sm"/>
                            <Label fx:id="weightLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            
                            <Label text="Visible Marks:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="label-sm"/>
                            <Label fx:id="marksLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" wrapText="true"/>
                        </GridPane>
                    </VBox>
                </VBox>

                <VBox spacing="20" HBox.hgrow="ALWAYS">
                    <VBox spacing="12" styleClass="card">
                        <Label text="Registered Address" styleClass="heading-sm"/>
                        <Label fx:id="fullAddressLabel" wrapText="true" style="-fx-font-style: italic; -fx-font-size: 13px;"/>
                    </VBox>

                    <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
                        <Label text="Medical &amp; Biometric Information" styleClass="heading-sm"/>
                        <GridPane vgap="10" hgap="20">
                            <Label text="Blood Group:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="label-sm"/>
                            <Label fx:id="bloodGroupLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="DNA Profile:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="label-sm"/>
                            <Label fx:id="dnaLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </HBox>
        </Tab>

        <Tab text="CASE HISTORY">
            <VBox spacing="15" style="-fx-padding: 20 0 0 0;">
                <TableView fx:id="caseTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="caseNumCol" text="Case Number" prefWidth="150"/>
                        <TableColumn fx:id="caseRoleCol" text="Role" prefWidth="120"/>
                        <TableColumn fx:id="caseStatusCol" text="Case Status" prefWidth="120"/>
                        <TableColumn fx:id="caseDateCol" text="Linked At" prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="ARRESTS &amp; EVIDENCE">
             <VBox spacing="15" style="-fx-padding: 20 0 0 0;">
                <TableView fx:id="arrestTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="arrestRefCol" text="Booking Ref" prefWidth="180"/>
                        <TableColumn fx:id="arrestDateCol" text="Arrest Date" prefWidth="180"/>
                        <TableColumn fx:id="arrestLocationCol" text="Location" prefWidth="250"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="ACTIVITY LOG">
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 20 0 0 0;">
                <VBox fx:id="timelineContainer" spacing="20" style="-fx-padding: 10;"/>
            </ScrollPane>
        </Tab>
    </TabPane>
</VBox>
