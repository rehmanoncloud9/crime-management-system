<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.text.Text?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.OfficerDetailController" styleClass="module">
    
    <!-- Top Fixed Header -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="view-header-premium" style="-fx-padding: 20 25;">
        <Button text="← Back to Registry" onAction="#handleBack" styleClass="btn, btn-outline-sm"/>
        <Separator orientation="VERTICAL" style="-fx-padding: 0 10;"/>
        <VBox>
            <Label text="OFFICER PROFILE" styleClass="text-muted-xs" style="-fx-letter-spacing: 1px;"/>
            <Label fx:id="headerNameLabel" text="Loading Profile..." styleClass="heading-md" style="-fx-text-fill: -cms-teal;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="statusBtn" text="Suspend Account" onAction="#handleToggleStatus" styleClass="btn, btn-outline-danger-sm"/>
            <Button text="Edit Profile" onAction="#handleEditProfile" styleClass="btn, btn-primary-sm" prefWidth="130"/>
        </HBox>
    </HBox>

    <!-- Main Content -->
    <StackPane VBox.vgrow="ALWAYS">
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="25" style="-fx-padding: 25;">
                
                <!-- Profile Summary Card -->
                <HBox spacing="35" styleClass="card-premium" alignment="CENTER_LEFT" style="-fx-padding: 30;">
                    <StackPane>
                        <ImageView fx:id="photoView" fitWidth="120" fitHeight="120" preserveRatio="true" styleClass="photo-frame"/>
                        <Circle fx:id="statusCircle" radius="10" stroke="white" strokeWidth="2.5" StackPane.alignment="BOTTOM_RIGHT">
                            <StackPane.margin><Insets bottom="8" right="8"/></StackPane.margin>
                        </Circle>
                    </StackPane>
                    
                    <VBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="nameLabel" styleClass="heading-lg" text="Officer Name" style="-fx-font-size: 28px;"/>
                        <Label fx:id="badgeLabel" styleClass="text-muted" text="BADGE #00000" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                           <Label fx:id="roleBadge" styleClass="badge-premium, badge-info" text="INVESTIGATOR"/>
                           <Label fx:id="statusBadge" styleClass="badge-premium, badge-success" text="ACTIVE"/>
                        </HBox>
                    </VBox>
                    
                    <Region HBox.hgrow="ALWAYS"/>
                    
                    <!-- Quick Stats in Header -->
                    <HBox spacing="20" alignment="CENTER">
                        <VBox alignment="CENTER" styleClass="stat-mini">
                            <Label fx:id="caseCountBadge" text="0" styleClass="stat-val-sm"/>
                            <Label text="CASES" styleClass="stat-lab-sm"/>
                        </VBox>
                        <Separator orientation="VERTICAL" prefHeight="40"/>
                        <VBox alignment="CENTER" styleClass="stat-mini">
                            <Label fx:id="perfEfficiencyHeader" text="0%" styleClass="stat-val-sm" style="-fx-text-fill: -cms-teal;"/>
                            <Label text="SOLVED" styleClass="stat-lab-sm"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- Tabbed Content Area -->
                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="cms-tabs-premium">
                    <Tab text="PROFILE DATA">
                        <HBox spacing="25" style="-fx-padding: 25 0 0 0;">
                            <!-- Official Info -->
                            <VBox spacing="20" prefWidth="500">
                                <VBox spacing="15" styleClass="card">
                                    <Label text="Official Assignment" styleClass="heading-sm" style="-fx-text-fill: -cms-teal;"/>
                                    <GridPane vgap="15" hgap="20">
                                        <Label text="Rank" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="label-sm-muted"/>
                                        <Label fx:id="rankLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" text="N/A" styleClass="label-val-bold"/>
                                        
                                        <Label text="Department" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="label-sm-muted"/>
                                        <Label fx:id="deptLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" text="N/A" styleClass="label-val-bold"/>
                                        
                                        <Label text="Precinct" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="label-sm-muted"/>
                                        <Label fx:id="precinctLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" text="N/A" styleClass="label-val-bold"/>

                                        <Label text="Service Since" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="label-sm-muted"/>
                                        <Label fx:id="joinedLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" text="N/A" styleClass="label-val-bold"/>
                                    </GridPane>
                                </VBox>

                                <VBox spacing="15" styleClass="card">
                                    <Label text="Personal &amp; Contact" styleClass="heading-sm" style="-fx-text-fill: -cms-teal;"/>
                                    <GridPane vgap="15" hgap="20">
                                        <Label text="Official Email" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="label-sm-muted"/>
                                        <Label fx:id="emailLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" text="N/A" styleClass="label-val-bold"/>
                                        
                                        <Label text="Phone Contact" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="label-sm-muted"/>
                                        <Label fx:id="phoneLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" text="N/A" styleClass="label-val-bold"/>

                                        <Label text="Date of Birth" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="label-sm-muted"/>
                                        <Label fx:id="dobLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" text="N/A" styleClass="label-val-bold"/>
                                    </GridPane>
                                </VBox>
                            </VBox>

                            <!-- System Info -->
                            <VBox spacing="20" HBox.hgrow="ALWAYS">
                                <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS">
                                    <Label text="System Audit" styleClass="heading-sm" style="-fx-text-fill: -cms-teal;"/>
                                    <GridPane vgap="15" hgap="20">
                                       <Label text="Last Activity" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="label-sm-muted"/>
                                       <Label fx:id="lastActiveLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" text="Never" styleClass="label-val-bold"/>

                                       <Label text="Registry Entry" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="label-sm-muted"/>
                                       <Label fx:id="createdAtLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" text="N/A" styleClass="label-val-bold"/>
                                    </GridPane>
                                    <Separator style="-fx-padding: 10 0;"/>
                                    <Button text="View Access Logs" styleClass="btn, btn-outline-sm" maxWidth="Infinity"/>
                                </VBox>
                            </VBox>
                        </HBox>
                    </Tab>

                    <Tab text="CASE REPOSITORY">
                        <VBox spacing="20" style="-fx-padding: 25 0 0 0;">
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <VBox>
                                    <Label text="Investigative Dossiers" styleClass="heading-sm"/>
                                    <Label text="Detailed list of all cases assigned to this officer" styleClass="text-muted-xs"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Export Report" styleClass="btn, btn-outline-sm"/>
                            </HBox>
                            <TableView fx:id="casesTable" VBox.vgrow="ALWAYS" styleClass="cms-table-premium">
                                <columns>
                                    <TableColumn fx:id="caseIdCol" text="CASE ID" prefWidth="120"/>
                                    <TableColumn fx:id="caseTitleCol" text="INVESTIGATION TITLE" prefWidth="300"/>
                                    <TableColumn fx:id="caseStatusCol" text="STATUS" prefWidth="150"/>
                                    <TableColumn fx:id="caseDateCol" text="COMMENCED" prefWidth="180"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <Tab text="PERFORMANCE &amp; KPI">
                        <VBox spacing="30" style="-fx-padding: 30;">
                            <VBox spacing="5">
                                <Label text="Officer Performance Analytics" styleClass="heading-md"/>
                                <Label text="Data-driven evaluation of investigative efficiency and success rates" styleClass="text-muted-sm"/>
                            </VBox>
                            
                            <FlowPane hgap="25" vgap="25">
                                <VBox spacing="12" styleClass="stat-card-premium" prefWidth="220">
                                    <Label text="TOTAL ASSIGNMENTS" styleClass="stat-label"/>
                                    <Label fx:id="perfTotalCases" text="0" styleClass="stat-value"/>
                                    <ProgressBar progress="1.0" maxWidth="Infinity" styleClass="progress-blue"/>
                                </VBox>
                                <VBox spacing="12" styleClass="stat-card-premium" prefWidth="220">
                                    <Label text="CLOSED (SUCCESS)" styleClass="stat-label"/>
                                    <Label fx:id="perfClosedCases" text="0" styleClass="stat-value" style="-fx-text-fill: -cms-success;"/>
                                    <ProgressBar fx:id="perfClosedProgress" progress="0.0" maxWidth="Infinity" styleClass="progress-green"/>
                                </VBox>
                                <VBox spacing="12" styleClass="stat-card-premium" prefWidth="220">
                                    <Label text="PENDING INVESTIGATION" styleClass="stat-label"/>
                                    <Label fx:id="perfActiveCases" text="0" styleClass="stat-value" style="-fx-text-fill: -cms-warning;"/>
                                    <ProgressBar fx:id="perfActiveProgress" progress="0.0" maxWidth="Infinity" styleClass="progress-orange"/>
                                </VBox>
                                <VBox spacing="12" styleClass="stat-card-premium" prefWidth="220">
                                    <Label text="RESOLVED RATE" styleClass="stat-label"/>
                                    <Label fx:id="perfEfficiency" text="0%" styleClass="stat-value" style="-fx-text-fill: -cms-teal;"/>
                                    <ProgressBar fx:id="perfEfficiencyProgress" progress="0.0" maxWidth="Infinity" styleClass="progress-teal"/>
                                </VBox>
                            </FlowPane>
                            
                            <VBox spacing="20" styleClass="card-info" style="-fx-padding: 25;">
                                <Label text="Performance Insights" styleClass="heading-sm"/>
                                <TextFlow lineSpacing="5">
                                    <Text text="Efficiency is calculated based on " styleClass="text-muted-sm"/>
                                    <Text text="Successfully Resolved Cases" styleClass="text-primary-sm" style="-fx-font-weight: bold;"/>
                                    <Text text=" against the total volume of work. " styleClass="text-muted-sm"/>
                                    <Text text="Targets: 75% resolution rate is considered exceptional." styleClass="text-success-xs" style="-fx-font-style: italic;"/>
                                </TextFlow>
                            </VBox>
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>
        </ScrollPane>

        <!-- Loading Overlay -->
        <StackPane fx:id="loadingOverlay" visible="false" styleClass="loading-overlay-premium">
            <VBox alignment="CENTER" spacing="15">
                <ProgressIndicator prefWidth="60" prefHeight="60"/>
                <Label text="Synchronizing Intelligence Data..." styleClass="text-muted-sm"/>
            </VBox>
        </StackPane>
    </StackPane>
</VBox>
