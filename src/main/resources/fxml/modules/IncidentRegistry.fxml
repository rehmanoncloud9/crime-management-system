<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox styleClass="module" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.IncidentRegistryController">
    <VBox spacing="20" styleClass="module-container">
        <HBox spacing="16" alignment="CENTER_LEFT">
            <Label text="Incident Command Hub" styleClass="heading-xl"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10" styleClass="search-bar-glass">
                <TextField fx:id="searchField" promptText="🔍 Search incident # or title..." prefWidth="350" styleClass="text-field-premium-sm"/>
            </HBox>
            <Button onAction="#handleNewIncident" text="+ LOG NEW INCIDENT" styleClass="btn-premium-teal"/>
            <Button onAction="#loadIncidents" text="↺" styleClass="btn-premium-outline-sm"/>
        </HBox>

        <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="content-area-glass">
            <ScrollPane fitToWidth="true" styleClass="scroll-pane-transparent" VBox.vgrow="ALWAYS">
                <FlowPane fx:id="incidentFlowPane" hgap="24" vgap="24" style="-fx-padding: 10;">
                    <!-- High-fidelity Incident cards injected here -->
                </FlowPane>
            </ScrollPane>
        </VBox>
    </VBox>
</VBox>
