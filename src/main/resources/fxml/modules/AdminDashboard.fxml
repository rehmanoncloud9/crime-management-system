<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="24" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.AdminDashboardController" styleClass="content-area">
    <padding><Insets bottom="28" left="28" right="28" top="28"/></padding>

    <!-- Title -->
    <VBox spacing="4">
        <Label text="Admin Dashboard" styleClass="heading-xl"/>
        <Label text="Operational overview and quick access" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 13px;"/>
    </VBox>

    <!-- Stats Cards Row — all DB driven -->
    <HBox fx:id="statsRow" spacing="16">
        <VBox styleClass="stat-card stat-card-blue" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="TOTAL CASES" styleClass="stat-label"/>
            <Label fx:id="totalCasesLabel" text="—" styleClass="stat-value"/>
            <Label text="In system" styleClass="text-muted"/>
        </VBox>
        <VBox styleClass="stat-card stat-card-green" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="ACTIVE CASES" styleClass="stat-label"/>
            <Label fx:id="activeCasesLabel" text="—" styleClass="stat-value"/>
            <Label text="Under investigation" styleClass="text-muted"/>
        </VBox>
        <VBox styleClass="stat-card stat-card-red" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="CLOSED CASES" styleClass="stat-label"/>
            <Label fx:id="closedCasesLabel" text="—" styleClass="stat-value"/>
            <Label text="Resolved" styleClass="text-muted"/>
        </VBox>
        <VBox styleClass="stat-card stat-card-orange" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="OFFICERS" styleClass="stat-label"/>
            <Label fx:id="totalOfficersLabel" text="—" styleClass="stat-value"/>
            <Label text="Active personnel" styleClass="text-muted"/>
        </VBox>
        <VBox styleClass="stat-card stat-card-teal" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="CRIMINALS" styleClass="stat-label"/>
            <Label fx:id="totalCriminalsLabel" text="—" styleClass="stat-value"/>
            <Label text="Registered" styleClass="text-muted"/>
        </VBox>
    </HBox>

    <!-- Quick Actions -->
    <VBox styleClass="card" spacing="16">
        <Label text="Quick Actions" styleClass="heading-md"/>
        <HBox spacing="12">
            <Button text="📁  New Case" onAction="#onAddCase" styleClass="quick-action-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="👮  Add Officer" onAction="#onAddOfficer" styleClass="quick-action-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="🔍  Search Criminal" onAction="#onSearchCriminal" styleClass="quick-action-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="🚨  Report Incident" onAction="#onNewIncident" styleClass="quick-action-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="🤖  AI Assistant" onAction="#onAIAnalytics" styleClass="quick-action-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
    </VBox>

    <!-- System Overview (DB-driven labels) -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
            <Label text="Recent Incidents" styleClass="heading-md"/>
            <Label fx:id="incidentsSummaryLabel" text="Loading..."
                   style="-fx-text-fill: rgba(255,255,255,0.6);" wrapText="true"/>
        </VBox>
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
            <Label text="AI Alerts" styleClass="heading-md"/>
            <Label fx:id="aiAlertsLabel" text="Loading..."
                   style="-fx-text-fill: rgba(255,255,255,0.6);" wrapText="true"/>
        </VBox>
    </HBox>

</VBox>
