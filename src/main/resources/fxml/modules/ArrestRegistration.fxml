<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cms.controller.ArrestRegistrationController"
      spacing="16" styleClass="content-area">
 
    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="🚔 Arrested Persons" styleClass="heading-xl"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Register Arrest" onAction="#handleNewArrest" styleClass="btn, btn-primary"/>
    </HBox>
 
    <!-- Summary Cards -->
    <HBox spacing="16">
        <VBox styleClass="card" style="-fx-padding: 16; -fx-min-width: 180;" alignment="CENTER" HBox.hgrow="ALWAYS">
            <Label text="Total Arrests" styleClass="text-muted"/>
            <Label fx:id="totalArrestsLabel" text="0" styleClass="stat-value" style="-fx-text-fill: -cms-teal;"/>
        </VBox>
        <VBox styleClass="card" style="-fx-padding: 16; -fx-min-width: 180;" alignment="CENTER" HBox.hgrow="ALWAYS">
            <Label text="This Month" styleClass="text-muted"/>
            <Label fx:id="monthArrestsLabel" text="0" styleClass="stat-value" style="-fx-text-fill: -cms-violet;"/>
        </VBox>
        <VBox styleClass="card" style="-fx-padding: 16; -fx-min-width: 180;" alignment="CENTER" HBox.hgrow="ALWAYS">
            <Label text="Cases Auto-Closed" styleClass="text-muted"/>
            <Label fx:id="autoClosedLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #10B981;"/>
        </VBox>
    </HBox>
 
    <!-- Arrest Records Table -->
    <TableView fx:id="arrestTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colBooking" text="Booking Ref" prefWidth="120"/>
            <TableColumn fx:id="colSuspect" text="Suspect Name" prefWidth="180"/>
            <TableColumn fx:id="colCase" text="Case Number" prefWidth="140"/>
            <TableColumn fx:id="colOfficer" text="Arresting Officer" prefWidth="160"/>
            <TableColumn fx:id="colCharges" text="Charges" prefWidth="200"/>
            <TableColumn fx:id="colDate" text="Arrest Date" prefWidth="140"/>
            <TableColumn fx:id="colLocation" text="Location" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
