<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" prefWidth="500" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.OfficerEditController" styleClass="glass-pane">
    
    <!-- Header -->
    <HBox styleClass="card-header-premium" alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20;">
        <VBox spacing="2">
            <Label text="Officer Profile Editor" styleClass="heading-md" style="-fx-text-fill: white;"/>
            <Label text="Update official credentials and profile data" styleClass="text-muted-xs" style="-fx-text-fill: rgba(255,255,255,0.7);"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="✕" onAction="#handleCancel" styleClass="btn-icon-close"/>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="20" style="-fx-padding: 25;">
            
            <!-- Photo Section -->
            <HBox alignment="CENTER_LEFT" spacing="25" styleClass="card" style="-fx-padding: 20;">
                <StackPane>
                    <ImageView fx:id="photoView" fitWidth="100" fitHeight="100" preserveRatio="true"/>
                    <Circle radius="50" fill="transparent" stroke="rgba(255,255,255,0.2)" strokeWidth="2"/>
                </StackPane>
                <VBox spacing="10">
                    <Label text="Profile Photo" styleClass="heading-sm"/>
                    <Label text="JPG or PNG, Max 2MB" styleClass="text-muted-xs"/>
                    <Button text="📷 Change Image" onAction="#handleChangePhoto" styleClass="btn, btn-outline-sm"/>
                    <Label fx:id="photoStatusLabel" text="" styleClass="text-success-xs"/>
                </VBox>
            </HBox>

            <!-- Details Form -->
            <VBox spacing="15" styleClass="card" style="-fx-padding: 20;">
                <Label text="Official Credentials" styleClass="heading-md"/>
                <GridPane vgap="18" hgap="25">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="130"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Badge ID" styleClass="form-label-premium" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="badgeField" editable="false" styleClass="text-field-premium, text-field-readonly" 
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Full Name" styleClass="form-label-premium" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="nameField" promptText="Enter officer name" styleClass="text-field-premium" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Rank / Title" styleClass="form-label-premium" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="rankField" promptText="e.g. Inspector, Detective" styleClass="text-field-premium" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Department" styleClass="form-label-premium" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="deptField" promptText="e.g. Special Operations, Homicide" styleClass="text-field-premium" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Assigned Precinct" styleClass="form-label-premium" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="precinctField" promptText="e.g. 1st Precinct" styleClass="text-field-premium" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="System Role" styleClass="form-label-premium" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="roleCombo" maxWidth="Infinity" styleClass="combo-box-premium" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label text="Contact Email" styleClass="form-label-premium" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <TextField fx:id="emailField" promptText="officer@cms.gov" styleClass="text-field-premium" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                    <Label text="Phone Number" styleClass="form-label-premium" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                    <TextField fx:id="phoneField" promptText="+92 300 0000000" styleClass="text-field-premium" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                    <Label text="Duty Status" styleClass="form-label-premium" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                    <ComboBox fx:id="statusCombo" maxWidth="Infinity" styleClass="combo-box-premium" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                </GridPane>
            </VBox>

            <!-- Danger Zone -->
            <VBox spacing="15" styleClass="card-danger-zone">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="⚠️" style="-fx-text-fill: -cms-rose; -fx-font-size: 18px;"/>
                    <VBox>
                        <Label text="Administrative Actions" styleClass="heading-sm" style="-fx-text-fill: -cms-rose;"/>
                        <Label text="Critical modifications restricted to admin" styleClass="text-muted-xs"/>
                    </VBox>
                </HBox>
                <HBox spacing="10">
                    <Button text="Reset Password" onAction="#handleResetPassword" styleClass="btn, btn-outline-danger-sm"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Delete Officer" onAction="#handleDeleteOfficer" styleClass="btn, btn-danger-sm"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Footer Actions -->
    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20; -fx-background-color: rgba(0,0,0,0.03);">
        <Button text="CANCEL" onAction="#handleCancel" styleClass="btn-premium-danger-outline"/>
        <Button text="APPLY CHANGES" onAction="#handleSave" styleClass="btn-premium-teal" prefWidth="180"/>
    </HBox>
</VBox>
