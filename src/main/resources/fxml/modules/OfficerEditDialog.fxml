<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" prefWidth="720" maxHeight="750" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.OfficerEditController" styleClass="glass-pane">
    
    <!-- Header: Liquid Crystal -->
    <HBox styleClass="card-header-premium" alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 22 28; -fx-background-radius: 28 28 0 0;">
        <StackPane style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 12; -fx-padding: 8;">
            <Label text="👤" style="-fx-font-size: 20px;"/>
        </StackPane>
        <VBox spacing="2">
            <Label text="Officer Profile Editor" styleClass="heading-md" style="-fx-text-fill: white; -fx-font-size: 18px;"/>
            <Label text="Manage identity, credentials, and command access" styleClass="text-muted-xs" style="-fx-text-fill: rgba(255,255,255,0.85);"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="✕" onAction="#handleCancel" styleClass="btn-icon-close" style="-fx-font-size: 14px; -fx-padding: 8 14;"/>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="25" style="-fx-padding: 28;">
            
            <!-- SECTION 1: IDENTITY & PHOTO -->
            <HBox spacing="28" alignment="TOP_LEFT">
                <VBox alignment="CENTER" spacing="15" styleClass="form-section-card" style="-fx-min-width: 200; -fx-padding: 25;">
                    <StackPane>
                        <ImageView fx:id="photoView" fitWidth="120" fitHeight="120" preserveRatio="true"/>
                        <Circle radius="62" fill="transparent" style="-fx-stroke: -cms-teal;" strokeWidth="2" opacity="0.2"/>
                    </StackPane>
                    <Button text="📷 CHANGE PHOTO" onAction="#handleChangePhoto" styleClass="btn-outline-sm" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="18" HBox.hgrow="ALWAYS" styleClass="form-section-card" style="-fx-padding: 25;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📋" style="-fx-font-size: 16px;"/>
                        <Label text="Official Assignment" styleClass="heading-sm" style="-fx-text-fill: -cms-teal;"/>
                    </HBox>
                    <GridPane vgap="16" hgap="20">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Badge ID" styleClass="form-label-premium" style="-fx-text-fill: -cms-t2;"/>
                            <TextField fx:id="badgeField" editable="false" styleClass="text-field-premium, text-field-readonly"/>
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Full Name" styleClass="form-label-premium" style="-fx-text-fill: -cms-t2;"/>
                            <TextField fx:id="nameField" promptText="Enter full name" styleClass="text-field-premium"/>
                        </VBox>

                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Rank / Title" styleClass="form-label-premium" style="-fx-text-fill: -cms-t2;"/>
                            <TextField fx:id="rankField" promptText="Rank title" styleClass="text-field-premium"/>
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Department" styleClass="form-label-premium" style="-fx-text-fill: -cms-t2;"/>
                            <TextField fx:id="deptField" promptText="Homicide, etc." styleClass="text-field-premium"/>
                        </VBox>

                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Command Role" styleClass="form-label-premium" style="-fx-text-fill: -cms-t2;"/>
                            <ComboBox fx:id="roleCombo" maxWidth="Infinity" styleClass="combo-box-premium"/>
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Duty Status" styleClass="form-label-premium" style="-fx-text-fill: -cms-t2;"/>
                            <ComboBox fx:id="statusCombo" maxWidth="Infinity" styleClass="combo-box-premium"/>
                        </VBox>
                    </GridPane>
                </VBox>
            </HBox>

            <!-- SECTION 2: CONTACT & SECURITY -->
            <HBox spacing="28">
                <VBox spacing="18" styleClass="form-section-card" HBox.hgrow="ALWAYS" style="-fx-padding: 25;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📞" style="-fx-font-size: 16px;"/>
                        <Label text="Contact &amp; Deployment" styleClass="heading-sm" style="-fx-text-fill: -cms-teal;"/>
                    </HBox>
                    <VBox spacing="15">
                        <VBox spacing="6">
                            <Label text="Official Email" styleClass="form-label-premium" style="-fx-text-fill: -cms-t2;"/>
                            <TextField fx:id="emailField" promptText="officer@cms.gov" styleClass="text-field-premium"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Phone Contact" styleClass="form-label-premium" style="-fx-text-fill: -cms-t2;"/>
                            <TextField fx:id="phoneField" promptText="+92 XXX XXXXXXX" styleClass="text-field-premium"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Assigned Precinct" styleClass="form-label-premium" style="-fx-text-fill: -cms-t2;"/>
                            <TextField fx:id="precinctField" promptText="HQ Precinct" styleClass="text-field-premium"/>
                        </VBox>
                    </VBox>
                </VBox>

                <VBox spacing="18" styleClass="form-section-card" HBox.hgrow="ALWAYS" style="-fx-padding: 25; -fx-background-color: rgba(64,196,255,0.03);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🔐" style="-fx-font-size: 16px;"/>
                        <Label text="Security Credentials" styleClass="heading-sm" style="-fx-text-fill: -cms-sky;"/>
                    </HBox>
                    <VBox spacing="15">
                        <VBox spacing="6">
                            <Label text="New Password" styleClass="form-label-premium" style="-fx-text-fill: -cms-t2;"/>
                            <PasswordField fx:id="newPasswordField" promptText="Leave blank to keep current" styleClass="text-field-premium"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Confirm Password" styleClass="form-label-premium" style="-fx-text-fill: -cms-t2;"/>
                            <PasswordField fx:id="confirmPasswordField" promptText="Verify new password" styleClass="text-field-premium"/>
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>

            <!-- SECTION 3: DANGER ZONE -->
            <VBox spacing="15" styleClass="card-danger-zone" style="-fx-padding: 20;">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <StackPane style="-fx-background-color: rgba(244,63,94,0.15); -fx-background-radius: 10; -fx-padding: 10;">
                        <Label text="⚠️" style="-fx-font-size: 20px;"/>
                    </StackPane>
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Administrative Safeguards" styleClass="heading-sm" style="-fx-text-fill: -cms-danger;"/>
                        <Label text="Permanent changes to officer identity and system records" styleClass="text-muted-xs"/>
                    </VBox>
                    <Button text="RESET TO DEFAULT" onAction="#handleResetPassword" styleClass="btn-outline-danger-sm"/>
                    <Button text="TERMINATE PROFILE" onAction="#handleDeleteOfficer" styleClass="btn-danger-sm"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Footer: Liquid Crystal Fixed -->
    <HBox spacing="18" alignment="CENTER_RIGHT" style="-fx-padding: 24 32; -fx-background-color: rgba(255,255,255,0.7); -fx-border-color: rgba(0,191,165,0.15) transparent transparent transparent; -fx-border-width: 1.5 0 0 0; -fx-background-radius: 0 0 28 28;">
        <Button text="DISCARD CHANGES" onAction="#handleCancel" styleClass="btn-premium-danger-outline"/>
        <Button text="SAVE OFFICER DATA" onAction="#handleSave" styleClass="btn-premium-teal" prefWidth="220"/>
    </HBox>
</VBox>


