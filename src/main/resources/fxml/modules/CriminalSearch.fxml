<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true"  styleClass="scroll-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.CriminalSearchController">
    <VBox spacing="16">
        <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>

        <Label text="Criminal Database" styleClass="heading-xl"/>

        <!-- Search Bar -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card">
            <TextField fx:id="nameSearchField" promptText="Name / Alias" prefWidth="200"/>
            <TextField fx:id="idSearchField" promptText="National ID" prefWidth="150"/>
            <ComboBox fx:id="genderFilter" promptText="Gender" prefWidth="110"/>
            <CheckBox fx:id="warrantFilter" text="Active Warrants Only"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleSearch" text="SEARCH" styleClass="btn, btn-primary"/>
            <Button onAction="#handleClear" text="CLEAR" styleClass="btn, btn-outline"/>
            <Button onAction="#handleAddCriminal" text="+ ENROLL SUSPECT" styleClass="btn-premium-teal-sm"/>
        </HBox>

        <!-- Results Table -->
        <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS" prefHeight="500">
            <columns>
                <TableColumn fx:id="photoCol" text="Photo" prefWidth="80"/>
                <TableColumn fx:id="nameCol" text="Full Name" prefWidth="200"/>
                <TableColumn fx:id="dobCol" text="Date of Birth" prefWidth="110"/>
                <TableColumn fx:id="genderCol" text="Gender" prefWidth="80"/>
                <TableColumn fx:id="idCol" text="National ID" prefWidth="130"/>
                <TableColumn fx:id="warrantCol" text="Warrant" prefWidth="100"/>
                <TableColumn fx:id="riskCol" text="Risk Score" prefWidth="100"/>
                <TableColumn fx:id="actionCol" text="Action" prefWidth="80"/>
            </columns>
        </TableView>
    </VBox>
</ScrollPane>
