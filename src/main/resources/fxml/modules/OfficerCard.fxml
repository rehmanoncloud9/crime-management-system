<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<VBox fx:id="cardRoot" spacing="12" alignment="CENTER" prefWidth="280" 
      styleClass="officer-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets bottom="16" left="16" right="16" top="16"/></padding>

    <StackPane>
        <ImageView fx:id="photoView" id="photoView" fitWidth="100" fitHeight="100" preserveRatio="true">
            <clip>
                <Circle centerX="50" centerY="50" radius="50"/>
            </clip>
        </ImageView>
        <Label fx:id="statusBadge" id="statusBadge" text="ACTIVE" StackPane.alignment="TOP_RIGHT" 
               styleClass="status-badge, status-active"/>
    </StackPane>

    <VBox alignment="CENTER" spacing="2">
        <Label fx:id="nameLabel" id="nameLabel" text="John Doe" styleClass="card-title"/>
        <Label fx:id="badgeLabel" id="badgeLabel" text="BADGE #12345" styleClass="card-subtitle"/>
    </VBox>

    <Separator/>

    <GridPane vgap="6" hgap="10" alignment="CENTER">
        <Label text="Rank:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="text-muted-xs"/>
        <Label fx:id="rankLabel" id="rankLabel" text="Detective" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="text-bold-xs"/>

        <Label text="Precinct:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="text-muted-xs"/>
        <Label fx:id="precinctLabel" id="precinctLabel" text="Central" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="text-bold-xs"/>

        <Label text="Contact:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="text-muted-xs"/>
        <Label fx:id="contactLabel" id="contactLabel" text="+92 300..." GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="text-bold-xs"/>

        <Label text="Cases:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="text-muted-xs"/>
        <Label fx:id="casesLabel" id="casesLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="text-bold-xs"/>
    </GridPane>

    <HBox spacing="8" alignment="CENTER">
        <Button text="Profile" fx:id="viewBtn" id="viewBtn" styleClass="btn, btn-primary-sm" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Edit" fx:id="editBtn" id="editBtn" styleClass="btn, btn-outline-sm" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Suspend" fx:id="statusBtn" id="statusBtn" styleClass="btn, btn-outline-sm" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="🗑" fx:id="deleteBtn" id="deleteBtn" styleClass="btn, btn-danger-sm"/>
    </HBox>
</VBox>
