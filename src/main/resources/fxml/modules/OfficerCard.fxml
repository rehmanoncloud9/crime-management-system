<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<VBox fx:id="cardRoot" spacing="15" alignment="TOP_CENTER" prefWidth="300" 
      styleClass="officer-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    
    <HBox alignment="CENTER_RIGHT">
        <Label fx:id="statusBadge" id="statusBadge" text="ACTIVE" styleClass="status-badge, status-active"/>
    </HBox>

    <StackPane>
        <ImageView fx:id="photoView" id="photoView" fitWidth="90" fitHeight="90" preserveRatio="true">
            <clip>
                <Circle centerX="45" centerY="45" radius="45"/>
            </clip>
        </ImageView>
        <Circle fill="transparent" stroke="rgba(0,191,165,0.2)" strokeWidth="2" radius="48"/>
    </StackPane>

    <VBox alignment="CENTER" spacing="4">
        <Label fx:id="nameLabel" id="nameLabel" text="John Doe" styleClass="card-title"/>
        <Label fx:id="badgeLabel" id="badgeLabel" text="BADGE #12345" styleClass="card-subtitle"/>
    </VBox>

    <VBox spacing="0" style="-fx-padding: 5 0;">
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="officer-card-info-row">
            <Label text="Rank" prefWidth="65" styleClass="text-muted-xs"/>
            <Label fx:id="rankLabel" id="rankLabel" text="Detective" styleClass="text-bold-xs" HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="officer-card-info-row">
            <Label text="Precinct" prefWidth="65" styleClass="text-muted-xs"/>
            <Label fx:id="precinctLabel" id="precinctLabel" text="Central" styleClass="text-bold-xs" HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="officer-card-info-row">
            <Label text="Contact" prefWidth="65" styleClass="text-muted-xs"/>
            <Label fx:id="contactLabel" id="contactLabel" text="+92 300..." styleClass="text-bold-xs" HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="officer-card-info-row" style="-fx-border-width: 1 0 1 0;">
            <Label text="Cases" prefWidth="65" styleClass="text-muted-xs"/>
            <Label fx:id="casesLabel" id="casesLabel" text="0" styleClass="text-bold-xs" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <HBox spacing="6" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
        <Button text="Profile" fx:id="viewBtn" id="viewBtn" styleClass="btn, btn-primary-sm, btn-xs" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Edit" fx:id="editBtn" id="editBtn" styleClass="btn, btn-outline-sm, btn-xs" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Suspend" fx:id="statusBtn" id="statusBtn" styleClass="btn, btn-outline-sm, btn-xs" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="🗑" fx:id="deleteBtn" id="deleteBtn" styleClass="btn, btn-delete-icon"/>
    </HBox>
</VBox>
