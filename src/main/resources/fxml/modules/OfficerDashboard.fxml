<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true"  styleClass="scroll-pane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.OfficerDashboardController">
    <VBox spacing="20">
        <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>

        <Label text="Officer Dashboard" styleClass="heading-xl"/>

        <HBox spacing="16">
            <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
                <Label text="My Assigned Cases" styleClass="heading-md"/>
                <ListView fx:id="assignedCasesList" prefHeight="150"/>
            </VBox>
            <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
                <Label text="⚠️ Active Warrant Alerts" styleClass="heading-md"/>
                <ListView fx:id="warrantsList" prefHeight="150"/>
            </VBox>
        </HBox>

        <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
            <Label text="Recent Incidents (Precinct)" styleClass="heading-md"/>
            <TableView fx:id="incidentsTable" VBox.vgrow="ALWAYS" prefHeight="250">
                <columns>
                    <TableColumn fx:id="incidentNumCol" text="Incident #" prefWidth="120"/>
                    <TableColumn fx:id="typeCol" text="Type" prefWidth="150"/>
                    <TableColumn fx:id="timeCol" text="Time" prefWidth="150"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
