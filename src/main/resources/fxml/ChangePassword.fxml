<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cms.controller.ChangePasswordController"
            stylesheets="@../css/login.css"
            styleClass="main-container">

    <GridPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <columnConstraints>
            <ColumnConstraints percentWidth="42.0" />
            <ColumnConstraints percentWidth="58.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS" />
        </rowConstraints>

        <!-- LEFT PANEL: Branding (same as login) -->
        <VBox GridPane.columnIndex="0" styleClass="left-panel">
            <Region VBox.vgrow="ALWAYS" maxHeight="400" prefHeight="240"/>
            <VBox alignment="CENTER" spacing="0">
                <StackPane>
                    <javafx.scene.shape.SVGPath
                        content="M24 4L6 10v12c0 11.1 7.68 21.48 18 24 10.32-2.52 18-12.9 18-24V10L24 4z"
                        fill="transparent" stroke="#00d4ff" strokeWidth="2.0" scaleX="3.0" scaleY="3.0"/>
                    <javafx.scene.shape.SVGPath
                        content="M24 8L10 12.5v9.5c0 8.32 5.76 16.11 14 18 8.24-1.89 14-9.68 14-18v-9.5L24 8z"
                        fill="transparent" stroke="#00d4ff" strokeWidth="1.0" scaleX="2.8" scaleY="2.8" opacity="0.6"/>
                </StackPane>
                <Region prefHeight="80"/>
                <Label text="CMS" styleClass="logo-text"/>
                <Label text="C R I M E   M A N A G E M E N T   S Y S T E M" styleClass="logo-subtitle"/>
                <Label text="v 5 . 0" styleClass="version-label">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                </Label>
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
        </VBox>

        <!-- RIGHT PANEL: Change Password Form -->
        <VBox GridPane.columnIndex="1" styleClass="right-panel">
            <Region VBox.vgrow="ALWAYS" maxHeight="350" prefHeight="200"/>

            <VBox spacing="30" maxWidth="400" alignment="CENTER_LEFT" VBox.vgrow="NEVER">
                <VBox spacing="6">
                    <Label text="Set New Password" styleClass="heading"/>
                    <Label text="For security, you must change your password before continuing."
                           styleClass="subtext" wrapText="true"/>
                    <Label fx:id="usernameLabel" styleClass="subtext"/>
                </VBox>

                <VBox spacing="18">
                    <VBox spacing="8">
                        <Label text="C U R R E N T   P A S S W O R D" styleClass="field-label"/>
                        <PasswordField fx:id="currentPasswordField" promptText="Current password"
                                       styleClass="input-field"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="N E W   P A S S W O R D" styleClass="field-label"/>
                        <PasswordField fx:id="newPasswordField" promptText="Minimum 8 characters"
                                       styleClass="input-field"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="C O N F I R M   N E W   P A S S W O R D" styleClass="field-label"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Repeat new password"
                                       styleClass="input-field"/>
                    </VBox>

                    <VBox spacing="10" alignment="CENTER">
                        <Button fx:id="submitButton" text="UPDATE PASSWORD AND CONTINUE"
                                onAction="#handleChangePassword" maxWidth="Infinity"
                                styleClass="auth-btn"/>
                        <Label fx:id="errorLabel" styleClass="error-label"
                               wrapText="true" alignment="CENTER" minHeight="20"/>
                    </VBox>
                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER" spacing="10">
                <Separator styleClass="footer-rule" maxWidth="400"/>
                <Label text="Contact your system administrator if you have trouble logging in."
                       styleClass="subtext"/>
                <padding><Insets bottom="40"/></padding>
            </VBox>
        </VBox>
    </GridPane>
</AnchorPane>
