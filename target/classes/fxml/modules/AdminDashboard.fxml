<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="24" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.AdminDashboardController" styleClass="module">
    <padding><Insets bottom="16" left="16" right="16" top="16"/></padding>

        <!-- Module Title -->
        <Label text="Dashboard" styleClass="heading-xl"/>

        <!-- Stats Cards Row -->
        <HBox fx:id="statsRow" spacing="16">
            <VBox styleClass="stat-card, stat-card-blue" spacing="4">
                <Label text="Total Cases" styleClass="stat-label"/>
                <Label fx:id="totalCasesLabel" text="—" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card, stat-card-green" spacing="4">
                <Label text="Active Cases" styleClass="stat-label"/>
                <Label fx:id="activeCasesLabel" text="—" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card, stat-card-red" spacing="4">
                <Label text="Closed Cases" styleClass="stat-label"/>
                <Label fx:id="closedCasesLabel" text="—" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card, stat-card-orange" spacing="4">
                <Label text="Officers" styleClass="stat-label"/>
                <Label fx:id="totalOfficersLabel" text="—" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card, stat-card-teal" spacing="4">
                <Label text="Criminals" styleClass="stat-label"/>
                <Label fx:id="totalCriminalsLabel" text="—" styleClass="stat-value"/>
            </VBox>
        </HBox>

        <!-- Quick Actions -->
        <VBox spacing="12">
            <Label text="Quick Actions" styleClass="heading-md"/>
            <HBox spacing="12">
                <VBox styleClass="quick-action" spacing="8" onMouseClicked="#onAddCase">
                    <Label text="📁" styleClass="quick-action-icon"/>
                    <Label text="New Case" styleClass="quick-action-label"/>
                </VBox>
                <VBox styleClass="quick-action" spacing="8" onMouseClicked="#onAddOfficer">
                    <Label text="👮" styleClass="quick-action-icon"/>
                    <Label text="Add Officer" styleClass="quick-action-label"/>
                </VBox>
                <VBox styleClass="quick-action" spacing="8" onMouseClicked="#onSearchCriminal">
                    <Label text="🔍" styleClass="quick-action-icon"/>
                    <Label text="Search Criminal" styleClass="quick-action-label"/>
                </VBox>
                <VBox styleClass="quick-action" spacing="8" onMouseClicked="#onNewIncident">
                    <Label text="🚨" styleClass="quick-action-icon"/>
                    <Label text="Report Incident" styleClass="quick-action-label"/>
                </VBox>
                <VBox styleClass="quick-action" spacing="8" onMouseClicked="#onAIAnalytics">
                    <Label text="🤖" styleClass="quick-action-icon"/>
                    <Label text="AI Assistant" styleClass="quick-action-label"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Recent Activity -->
        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <Label text="System Overview" styleClass="heading-md"/>
            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Recent Incidents" styleClass="heading-md"/>
                    <Label fx:id="incidentsSummaryLabel" text="Loading..." styleClass="text-secondary" wrapText="true"/>
                </VBox>
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="AI Alerts" styleClass="heading-md"/>
                    <Label fx:id="aiAlertsLabel" text="Loading..." styleClass="text-secondary" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
