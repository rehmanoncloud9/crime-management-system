<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.PersonRegistrationController" styleClass="module">
        <padding><Insets bottom="16" left="16" right="16" top="16"/></padding>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="← Back to Registry" onAction="#handleBack" styleClass="btn, btn-outline-sm"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="formTitle" text="Register Person Profile" styleClass="heading-xl"/>
        </HBox>

        <!-- Photo + Form -->
        <HBox spacing="24">
            <VBox spacing="12" alignment="TOP_CENTER" styleClass="card" style="-fx-min-width: 180;">
                <ImageView fx:id="photoView" fitWidth="150" fitHeight="150" preserveRatio="true"/>
                <Button text="📷 Upload Photo" onAction="#handleUploadPhoto" styleClass="btn, btn-outline" style="-fx-border-color: #00D4FF; -fx-text-fill: #00D4FF; -fx-background-color: rgba(0,212,255,0.08);"/>
            </VBox>

            <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Personal Information" styleClass="heading-md"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <CheckBox fx:id="unknownPersonCheck" text="Unknown Person (Unidentified)" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                </HBox>
                <GridPane hgap="16" vgap="12">
                    <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="firstNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250"/>

                    <Label text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="lastNameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Classification:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="personStatusCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="250"/>

                    <Label text="Gender:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <ComboBox fx:id="genderCombo" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Date of Birth:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <DatePicker fx:id="dobPicker" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Country:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="nationalityCombo" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label text="CNIC (e.g., 12345-1234567-1):" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <TextField fx:id="nationalIdField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                </GridPane>
            </VBox>
        </HBox>

        <!-- Criminal Details -->
        <VBox spacing="12" styleClass="card">
            <Label text="Criminal Record Details" styleClass="heading-md"/>
            <GridPane hgap="16" vgap="12">
                <Label text="Aliases (Comma separated):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="aliasesField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="350"/>
                
                <Label text="Gang Affiliation:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="gangField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="250"/>
                
                <Label text="Active Warrant:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <CheckBox fx:id="warrantCheck" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
        </VBox>

        <!-- Physical Characteristics -->
        <VBox spacing="12" styleClass="card">
            <Label text="Physical Characteristics" styleClass="heading-md"/>
            <HBox spacing="20">
                <VBox spacing="6">
                    <Label text="Height (cm):"/>
                    <TextField fx:id="heightField" prefWidth="120"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Weight (kg):"/>
                    <TextField fx:id="weightField" prefWidth="120"/>
                </VBox>
            </HBox>
            <VBox spacing="6">
                <Label text="Distinguishing Marks:"/>
                <TextArea fx:id="marksArea" prefHeight="70" wrapText="true"/>
            </VBox>
            <GridPane hgap="16" vgap="12">
                <Label text="District:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="districtCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200"/>
                
                <Label text="City:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cityCombo" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="200"/>
                
                <Label text="Area/Neighborhood:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="areaCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200"/>
            </GridPane>
            <VBox spacing="6">
                <Label text="Street Address / Details:"/>
                <TextArea fx:id="addressArea" prefHeight="70" wrapText="true"/>
            </VBox>
        </VBox>

        <!-- Medical Information -->
        <VBox spacing="12" styleClass="card">
            <Label text="Medical Information" styleClass="heading-md"/>
            <GridPane hgap="16" vgap="12">
                <Label text="Blood Group:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="bloodGroupCombo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="DNA Profile Ref:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="dnaProfileField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="250"/>
            </GridPane>
            <HBox spacing="20">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Known Diseases:"/>
                    <TextArea fx:id="diseasesArea" prefHeight="70" wrapText="true"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Injuries:"/>
                    <TextArea fx:id="injuriesArea" prefHeight="70" wrapText="true"/>
                </VBox>
            </HBox>
            <VBox spacing="6">
                <Label text="Medical Notes:"/>
                <TextArea fx:id="medicalNotesArea" prefHeight="70" wrapText="true"/>
            </VBox>
        </VBox>

        <!-- Actions -->
        <HBox spacing="12">
            <Button fx:id="saveBtn" onAction="#handleSave" text="SAVE PROFILE" styleClass="btn, btn-success"/>
            <Button onAction="#handleClear" text="CLEAR" styleClass="btn, btn-outline" style="-fx-border-color: #00D4FF; -fx-text-fill: #00D4FF; -fx-background-color: rgba(0,212,255,0.08);"/>
        </HBox>
</VBox>
