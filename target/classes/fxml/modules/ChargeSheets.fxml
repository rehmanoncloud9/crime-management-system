<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cms.controller.ChargeSheetsController">
    <Label text="Charge Sheet Generation" textFill="#2c3e50">
        <font><Font name="System Bold" size="24.0"/></font>
    </Label>
    
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Select Investigation Case:"/>
        <ComboBox fx:id="caseCombo" prefWidth="300" promptText="Select Case File"/>
    </HBox>
    
    <VBox spacing="10" style="-fx-background-color: #0D1526; -fx-padding: 20; -fx-border-color: rgba(0,212,255,0.15); -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER">
            <Label text="FORMAL CHARGE SHEET" style="-fx-font-weight: bold; -fx-font-size: 18;"/>
        </HBox>
        <Separator/>
        <GridPane hgap="20" vgap="10">
            <Label text="Defendant Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="defendantNameLabel" text="..." GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            
            <Label text="Incident Reference:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="incidentRefLabel" text="..." GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
        
        <Label text="Statutory Charges &amp; Descriptions:" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="chargesArea" prefHeight="250" wrapText="true" promptText="List the specific sections of the penal code violated..."/>
        
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button onAction="#handleGenerate" text="GENERATE DOCUMENT" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button onAction="#handlePrint" text="PRINT / EXPORT" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
        </HBox>
    </VBox>
</VBox>
