<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cms.controller.ArrestRegistrationController"
      spacing="16" styleClass="module-content" style="-fx-padding: 24;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="🚔 Arrested Persons" styleClass="section-title"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #00D4FF;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Register Arrest" onAction="#handleNewArrest"
                styleClass="accent-btn"
                style="-fx-background-color: linear-gradient(to right, #00D4FF, #7B5CF6);
                       -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 24;
                       -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

    <!-- Summary Cards -->
    <HBox spacing="16">
        <VBox styleClass="stat-card" style="-fx-background-color: rgba(0,212,255,0.08);
              -fx-border-color: rgba(0,212,255,0.25); -fx-border-radius: 10; -fx-background-radius: 10;
              -fx-padding: 16; -fx-min-width: 180;" alignment="CENTER">
            <Label text="Total Arrests" style="-fx-text-fill: #8899AA; -fx-font-size: 11px;"/>
            <Label fx:id="totalArrestsLabel" text="0"
                   style="-fx-text-fill: #00D4FF; -fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox styleClass="stat-card" style="-fx-background-color: rgba(123,92,246,0.08);
              -fx-border-color: rgba(123,92,246,0.25); -fx-border-radius: 10; -fx-background-radius: 10;
              -fx-padding: 16; -fx-min-width: 180;" alignment="CENTER">
            <Label text="This Month" style="-fx-text-fill: #8899AA; -fx-font-size: 11px;"/>
            <Label fx:id="monthArrestsLabel" text="0"
                   style="-fx-text-fill: #7B5CF6; -fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox styleClass="stat-card" style="-fx-background-color: rgba(46,204,113,0.08);
              -fx-border-color: rgba(46,204,113,0.25); -fx-border-radius: 10; -fx-background-radius: 10;
              -fx-padding: 16; -fx-min-width: 180;" alignment="CENTER">
            <Label text="Cases Auto-Closed" style="-fx-text-fill: #8899AA; -fx-font-size: 11px;"/>
            <Label fx:id="autoClosedLabel" text="0"
                   style="-fx-text-fill: #2ECC71; -fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- Arrest Records Table -->
    <TableView fx:id="arrestTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: transparent;">
        <columns>
            <TableColumn fx:id="colBooking" text="Booking Ref" prefWidth="120"/>
            <TableColumn fx:id="colSuspect" text="Suspect Name" prefWidth="180"/>
            <TableColumn fx:id="colCase" text="Case Number" prefWidth="140"/>
            <TableColumn fx:id="colOfficer" text="Arresting Officer" prefWidth="160"/>
            <TableColumn fx:id="colCharges" text="Charges" prefWidth="200"/>
            <TableColumn fx:id="colDate" text="Arrest Date" prefWidth="140"/>
            <TableColumn fx:id="colLocation" text="Location" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
