<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<VBox styleClass="module" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cms.controller.UserAdminController">
    <VBox spacing="16">
        <padding><Insets bottom="8" left="8" right="8" top="8"/></padding>

        <Label text="Officers &amp; Users" styleClass="heading-xl"/>

        <!-- Toolbar -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="module-toolbar">
            <Button onAction="#handleCreateUser" text="+ Create New User" styleClass="btn, btn-primary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="🔍 Search by badge # or name" prefWidth="280"/>
        </HBox>

        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <!-- New User Form Panel (Hidden by default) -->
            <VBox fx:id="formPanel" spacing="12" styleClass="card" prefWidth="320" managed="false" visible="false">
                <Label text="New Officer Profile" styleClass="heading-md"/>
                
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <ImageView fx:id="newUserPhotoView" fitWidth="70" fitHeight="70" preserveRatio="true"/>
                    <Button text="📷 Upload" onAction="#handleUploadNewPhoto" styleClass="btn, btn-outline"/>
                </HBox>

                <GridPane vgap="10" hgap="8">
                    <Label text="Badge #:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="newBadgeField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="newNameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="newRoleCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>

                    <Label text="Precinct:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="newPrecinctField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="newEmailField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <TextField fx:id="newPhoneField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                </GridPane>

                <Region VBox.vgrow="ALWAYS"/>
                
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Cancel" onAction="#handleCancelNewUser" styleClass="btn, btn-outline"/>
                    <Button text="Save Officer" onAction="#handleSaveNewUser" styleClass="btn, btn-success"/>
                </HBox>
            </VBox>

            <!-- Officers Table (Now FlowPane) -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS">
                <FlowPane fx:id="userFlowPane" hgap="15" vgap="15" style="-fx-padding: 10;"/>
            </ScrollPane>
        </HBox>
    </VBox>
</VBox>
